;; (p/stop! song)
;; (def layered (p/together song (p/for-beats 8
;;   (p/pattern pulse :every [1] :hz 110 :amp 0.03))))
;; (layered)
;; (def twice (p/repeat-times 2 song))
;; (twice :id :set)
