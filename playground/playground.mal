;; A held body needs k-rate controls and must sustain without a p3 envelope.
;; Changing controls keeps the voice alive. Changing the FX chain starts a new
;; voice; changing just an effect's values keeps its state.
;; (p/definst tone [hz 110 amp 0.04] (csound/poscil amp hz))
;; (def drone (p/with-defaults tone :id :drone :legato true))
;; (drone)
;; (drone :hz 165)
;; (drone :every [1 2] :hz [110 165 220] :fx (flanger :rate 0.2))
;; (p/stop! drone)
;; (def held-section (p/for-beats 8
;;   (p/pattern drone :every [1 2] :hz [110 165 220])))
;; (held-section) ; stops the held voice at eight beats

;; The playground supplies a two-second stereo sample at engine startup.
;; Import file copies your own WAV/AIFF/FLAC and prints a load form.
;; Loading is silent; the result accepts patterns, effects, and compositions.
;; (require '[panaeolus.sampler :as sampler] '[panaeolus.fx :refer [bbcut]])
;; (def drums (sampler/load "panaeolus-demo.wav"))
;; (p/stop-all!)
;; (drums) ; one note at -6 dB, lasting the file's duration
;; (drums :every [1] :dur 0.45 :start [0 0.25 0.5 0.75] :rate [1 0.75])
;; (drums :every [4] :dur 2 :fx (bbcut :bpm 120 :subdiv 8 :repeats [1 2]))
;; (def backward (sampler/load "panaeolus-demo.wav" :mode :reverse :id :backward))
;; (backward :every [2] :dur 1 :start 0.5 :end 1)
;; (p/stop-all!)
;; (drums :legato true :start 0.25 :end 0.5 :cross 0.01)
;; (drums :legato true :rate 0.5 :pan -0.5) ; omitted controls use defaults
;; (p/stop! drums)
;; :start/:end are file fractions, :cross is seconds, :pan is -1..1.
;; :mode is fixed when loading: :forward, :reverse, or :pingpong.
;; flooper2 applies new bounds/crossfade at the next wrap. Cutter edits restart
;; its phrase. :bpm controls cuts explicitly; sample playback follows :rate.

;; Built-in plucks: select/evaluate these forms after stopping the starter.
;; (require '[panaeolus.instruments.pluck :refer [pluck fmpluck]])
;; (p/stop-all!)
;; (pluck) ; one note with defaults
;; (pluck 60 -6 :tone 0.7) ; positional note and dB, then named controls
;; (pluck :every [0.25 0.5] :note [60 67 72] :db [-6 -9] :tone 0.7)
;; (fmpluck :every [0.5] :note [48 60 55] :db -6 :ratio 1.5 :index 3
;;   :fx (flanger :rate 0.2))
;; (p/stop-all!)
;; :db 0 is the reference loudness; -6 is 6 dB quieter. :amp is linear.
;; :decay is seconds to -60 dB; :dur ends the note. Plucks retrigger each event.

