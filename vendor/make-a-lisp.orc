    else
      result init MalCsoundInstrumentSource(MalAt(args, 0), MalAt(args, 1), MalAt(args, 2))
    endif

  elseif (strcmp(fn.string, "csound/do") == 0) ithen
    result init MalCsoundSequence(args)
  elseif (strcmp(fn.string, "csound/event") == 0) ithen
    result init MalCsoundEvent(args)

  elseif (strcmp(fn.string, "readline") == 0) ithen
    if (args.length != 1) ithen
      result init MalArityError(fn.string, 1, args.length)
    else
      prompt:MalValue init MalAt(args, 0)

      if (prompt.type != $MAL_STRING_TYPE) ithen
        result init MalMkError("readline: expected string argument")
      else
        // Terminal I/O belongs to the k-rate driver.
        result init MalInputTake()
      endif
    endif

  elseif (strcmp(fn.string, "read-string") == 0) ithen
    if (args.length != 1) ithen
      result init MalArityError(fn.string, 1, args.length)
    else
      value:MalValue init MalAt(args, 0)

      if (value.type != $MAL_STRING_TYPE) ithen
        result init MalMkError("read-string: expected string argument")
      else
        result init read_str(value.string)
      endif
    endif

  elseif (strcmp(fn.string, "slurp") == 0) ithen
    if (args.length != 1) ithen
      result init MalArityError(fn.string, 1, args.length)
    else
      value:MalValue init MalAt(args, 0)

      if (value.type != $MAL_STRING_TYPE) ithen
        result init MalMkError("slurp: expected string argument")
      else
        result init MalSlurpFile(value.string)
      endif
    endif

  elseif (strcmp(fn.string, "atom") == 0) ithen
    if (args.length != 1) ithen
      result init MalArityError(fn.string, 1, args.length)
    else
      result init MalMkAtom(MalAt(args, 0))
    endif

  elseif (strcmp(fn.string, "atom?") == 0) ithen
    if (args.length != 1) ithen
      result init MalArityError(fn.string, 1, args.length)
    else
      value:MalValue init MalAt(args, 0)
      result init MalMkBool(value.type == $MAL_ATOM_TYPE ? 1 : 0)
    endif

  elseif (strcmp(fn.string, "deref") == 0) ithen
    if (args.length != 1) ithen
      result init MalArityError(fn.string, 1, args.length)
    else
      atom:MalValue init MalAt(args, 0)

      if (atom.type == $MAL_REDUCED_TYPE) ithen
        result init MalAt(atom, 0)
      elseif (atom.type != $MAL_ATOM_TYPE) ithen
        result init MalMkError("deref: expected atom or reduced value")
      else
        result init MalAtomValue(atom)
      endif
    endif

  elseif (strcmp(fn.string, "reset!") == 0) ithen
    if (args.length != 2) ithen
      result init MalArityError(fn.string, 2, args.length)
    else
      atom:MalValue init MalAt(args, 0)

      if (atom.type != $MAL_ATOM_TYPE) ithen
        result init MalMkError("reset!: first argument must be an atom")
      else
        value:MalValue init MalAt(args, 1)
        result init MalAtomSetValue(atom, value)
      endif
    endif

  elseif (strcmp(fn.string, "swap!") == 0) ithen
    if (args.length < 2) ithen
      result init MalMkError(sprintf("swap!: expected at least 2 arguments, got %d", \
        args.length))
    else
      atom:MalValue init MalAt(args, 0)

      if (atom.type != $MAL_ATOM_TYPE) ithen
        result init MalMkError("swap!: first argument must be an atom")
      else
        applyFn:MalValue init MalAt(args, 1)
        applyArgs:MalValue init MalMkValue($MAL_LIST_TYPE)
        applyArgs init MalAppendValue(applyArgs, MalAtomValue(atom))

        if (args.length > 2) ithen
          for index in [2 ... args.length - 1] do
            applyArgs init MalAppendValue(applyArgs, MalAt(args, index))
          od
        endif

        result init MalApply(applyFn, applyArgs)
        if (result.type != $MAL_ERROR_TYPE) ithen
          result init MalAtomSetValue(atom, result)
        endif
      endif
    endif

  elseif (strcmp(fn.string, "=") == 0) ithen
    if (args.length != 2) ithen
      result init MalArityError(fn.string, 2, args.length)
    else
      left:MalValue init MalAt(args, 0)
      right:MalValue init MalAt(args, 1)
      result init MalMkBool(MalEquals(left, right))
    endif

  elseif (strcmp(fn.string, ">") == 0 || \
          strcmp(fn.string, ">=") == 0 || \
          strcmp(fn.string, "<") == 0 || \
          strcmp(fn.string, "<=") == 0) ithen
    result init MalApplyNumericComparison(fn, args)

  elseif (strcmp(fn.string, "not") == 0) ithen
    if (args.length != 1) ithen
      result init MalArityError(fn.string, 1, args.length)
    else
      value:MalValue init MalAt(args, 0)
      result init MalMkBool(MalIsTruthy(value) == 0 ? 1 : 0)
    endif

  elseif (strcmp(fn.string, "macro?") == 0) ithen
    if (args.length != 1) ithen
      result init MalArityError(fn.string, 1, args.length)
    else
      result init MalMkBool(MalIsMacro(MalAt(args, 0)))
    endif

  elseif (strcmp(fn.string, "prn") == 0) ithen
    output:S init MalJoinPrintedArgs(args, 1, " ")
    prints "%s\n", output
    result init MalMkValue($MAL_NIL_TYPE)

  else
    result init MalApplyCoreBuiltin(fn, args)
  endif

  xout result
endop

opcode MalRestParamIndex(params:MalValue):i
  result:i = -1

  if (params.length > 0) ithen
    for index in [0 ... params.length - 1] do
      param:MalValue init MalAt(params, index)

      if (param.type == $MAL_SYMBOL_TYPE && strcmp(param.string, "&") == 0) ithen
        result = index
        break
      endif
    od
  endif

  xout result
endop

opcode MalBindFunctionEnv(fn:MalValue, args:MalValue):(MalValue, MalEnv)
  result:MalValue init MalMkValue($MAL_NIL_TYPE)
  callEnv:MalEnv init MalEnvHandle(-1)
  params:MalValue init MalFunctionParams(fn)
  restIndex:i = MalRestParamIndex(params)
  requiredCount:i = restIndex >= 0 ? restIndex : params.length

  if (restIndex < 0 && args.length != params.length) ithen
    result init MalMkError(sprintf("fn*: expected %d arguments, got %d", \
      params.length, args.length))
  elseif (restIndex >= 0 && args.length < requiredCount) ithen
    result init MalMkError(sprintf("fn*: expected at least %d arguments, got %d", \
      requiredCount, args.length))
  elseif (lenarray(fn.env) == 0) ithen
    result init MalMkError("fn*: missing closure environment")
  else
    closure:MalEnv[] init fn.env
    callEnv init MalMkEnvWithOuter(closure[0])

    if (strlen(fn.string) > 0) ithen
      callEnv.namespace init fn.string
      callEnv init MalEnvStore(callEnv)
    endif

    if (requiredCount > 0) ithen
      for index in [0 ... requiredCount - 1] do
        param:MalValue init MalAt(params, index)
        arg:MalValue init MalAt(args, index)
        callEnv init MalEnvSet(callEnv, param.string, arg)
      od
    endif

    if (restIndex >= 0) ithen
      restName:MalValue init MalAt(params, restIndex + 1)
      restValues:MalValue init MalMkValue($MAL_LIST_TYPE)

      if (args.length > requiredCount) ithen
        for index in [requiredCount ... args.length - 1] do
          arg:MalValue init MalAt(args, index)
          restValues init MalAppendValue(restValues, arg)
        od
      endif

      callEnv init MalEnvSet(callEnv, restName.string, restValues)
    endif

  endif

  xout result, callEnv
endop

opcode MalApplyFunction(fn:MalValue, args:MalValue):MalValue
  result:MalValue, callEnv:MalEnv = MalBindFunctionEnv(fn, args)

  if (result.type != $MAL_ERROR_TYPE) ithen
    body:MalValue init MalFunctionBody(fn)
    bodyInputEnv:MalEnv init MalEnvHandle(callEnv.id)
    result, callEnv = MalEvalInternal(body, bodyInputEnv)
  endif

  MalEnvRelease(callEnv)

  xout result
endop

opcode MalApply(fn:MalValue, args:MalValue):MalValue
  if (fn.type == $MAL_BUILTIN_OPERATOR_TYPE) ithen
    result:MalValue init MalApplyBuiltinOperator(fn, args)
  elseif (fn.type == $MAL_BUILTIN_TYPE) ithen
    if (lenarray(fn.env) > 0) ithen
      result:MalValue init MalApplyNamespaceBuiltin(fn, args)
    else
      result:MalValue init MalApplyBuiltin(fn, args)
    endif
  elseif (fn.type == $MAL_BUILTIN_OPCODE_TYPE) ithen
    result:MalValue init MalApplyCsoundOpcode(fn, args)
  elseif (fn.type == $MAL_FUNCTION_TYPE) ithen
    result:MalValue init MalApplyFunction(fn, args)
  elseif (fn.type == $MAL_CSOUND_INSTRUMENT_TYPE) ithen
    result:MalValue init MalScheduleCsoundInstrument(fn, args, 0, 1)
  else
    result:MalValue init MalMkError(sprintf("cannot apply %s", pr_str(fn)))
  endif

  xout result
endop

opcode MalEvalSequenceEnv(ast:MalValue, env:MalEnv, startIndex:i, resultType:i):(MalValue, MalEnv)
  result:MalValue init MalMkValue(resultType)
  currentEnv:MalEnv init MalEnvHandle(env.id)
  index:i = startIndex
  done:i = 0

  while (index < ast.length && done == 0) do
    value:MalValue init MalAt(ast, index)
    valueInputEnv:MalEnv init MalEnvHandle(currentEnv.id)
    evaluated:MalValue, currentEnv = MalEvalInternal(value, valueInputEnv)

    if (evaluated.type == $MAL_ERROR_TYPE) ithen
      result init evaluated
      done = 1
    else
      result init MalAppendValue(result, evaluated)
    endif

    index += 1
  od

  xout result, currentEnv
endop

opcode MalUnevaluatedArgs(ast:MalValue):MalValue
  result:MalValue init MalMkValue($MAL_LIST_TYPE)

  if (ast.length > 1) ithen
    for index in [1 ... ast.length - 1] do
      result init MalAppendValue(result, MalAt(ast, index))
    od
  endif

  xout result
endop

opcode MalEvalHashMapEnv(ast:MalValue, env:MalEnv):(MalValue, MalEnv)
  result:MalValue init MalMkValue($MAL_HASH_MAP_TYPE)
  currentEnv:MalEnv init MalEnvHandle(env.id)
  index:i = 0
  done:i = 0

  while (index < ast.length && done == 0) do
    key:MalValue init MalAt(ast, index)
    value:MalValue init MalAt(ast, index + 1)
    valueInputEnv:MalEnv init MalEnvHandle(currentEnv.id)
    evaluated:MalValue, currentEnv = MalEvalInternal(value, valueInputEnv)

    if (evaluated.type == $MAL_ERROR_TYPE) ithen
      result init evaluated
      done = 1
    else
      result init MalMapAssoc(result, key, evaluated)
    endif

    index += 2
  od

  xout result, currentEnv
endop

opcode MalEvalAstEnv(ast:MalValue, env:MalEnv):(MalValue, MalEnv)
  result:MalValue init ast
  currentEnv:MalEnv init MalEnvHandle(env.id)
  switch ast.type
    case $MAL_SYMBOL_TYPE
      result init MalResolveSymbol(env, ast.string)

    case $MAL_LIST_TYPE
      result, currentEnv = MalEvalSequenceEnv(ast, env, 0, $MAL_LIST_TYPE)

    case $MAL_VECTOR_TYPE
      result, currentEnv = MalEvalSequenceEnv(ast, env, 0, $MAL_VECTOR_TYPE)

    case $MAL_HASH_MAP_TYPE
      result, currentEnv = MalEvalHashMapEnv(ast, env)
  endsw

  xout result, currentEnv
endop

opcode MalEvalQuote(ast:MalValue):MalValue
  if (ast.length != 2) ithen
    result:MalValue init MalArityError("quote", 1, ast.length - 1)
  else
    result:MalValue init MalAt(ast, 1)
  endif

  xout result
endop

opcode MalQuasiquoteSequence(ast:MalValue):MalValue
  result:MalValue init MalMkValue($MAL_LIST_TYPE)

  if (ast.length > 0) ithen
    for offset in [0 ... ast.length - 1] do
      index:i = ast.length - offset - 1
      element:MalValue init MalAt(ast, index)

      if (MalIsForm(element, "splice-unquote") == 1) ithen
        if (element.length != 2) ithen
          result init MalArityError("splice-unquote", 1, element.length - 1)
          break
        endif

        result init MalMkList3(MalMkSymbol("concat"), MalAt(element, 1), result)
      else
        quotedElement:MalValue init MalQuasiquote(element)

        if (quotedElement.type == $MAL_ERROR_TYPE) ithen
          result init quotedElement
          break
        endif

        result init MalMkList3(MalMkSymbol("cons"), quotedElement, result)
      endif
    od
  endif

  xout result
endop

opcode MalQuasiquote(ast:MalValue):MalValue
  result:MalValue init ast
  if (MalIsForm(ast, "unquote") == 1) ithen
    if (ast.length != 2) ithen
      result init MalArityError("unquote", 1, ast.length - 1)
    else
      result init MalAt(ast, 1)
    endif
  else
    switch ast.type
      case $MAL_LIST_TYPE
        result init MalQuasiquoteSequence(ast)

      case $MAL_VECTOR_TYPE
        quotedValues:MalValue init MalQuasiquoteSequence(ast)

        if (quotedValues.type == $MAL_ERROR_TYPE) ithen
          result init quotedValues
        else
          result init MalMkList2(MalMkSymbol("vec"), quotedValues)
        endif

      case $MAL_SYMBOL_TYPE
        result init MalMkList2(MalMkSymbol("quote"), ast)

      case $MAL_HASH_MAP_TYPE
        result init MalMkList2(MalMkSymbol("quote"), ast)
    endsw
  endif

  xout result
endop

opcode MalIsFnForm(value:MalValue):i
  result:i = 0

  if (value.type == $MAL_LIST_TYPE && value.length > 0) ithen
    head:MalValue init MalAt(value, 0)

    if (head.type == $MAL_SYMBOL_TYPE && strcmp(head.string, "fn*") == 0) ithen
      result = 1
    endif
  endif

  xout result
endop

opcode MalFunctionCaptureEnv(fn:MalValue, env:MalEnv):MalValue
  if (fn.type == $MAL_FUNCTION_TYPE) ithen
    retainedEnv:MalEnv init MalEnvRetain(env)
    closure:MalEnv[] init 1
    closure[0] init MalEnvHandle(retainedEnv.id)
    result:MalValue init fn.type, fn.number, retainedEnv.namespace, fn.list, closure, \
      fn.metadata, fn.length, fn.isMacro, fn.astRef
  else
    result:MalValue init fn
  endif

  xout result
endop

opcode MalRefreshTopLevelFunctionClosures(env:MalEnv):MalEnv
  xout env
endop

opcode MalEvalDefinition(ast:MalValue, env:MalEnv, name:S, asMacro:i, atRoot:i):(MalValue, MalEnv)
  result:MalValue init MalMkValue($MAL_NIL_TYPE)
  currentEnv:MalEnv init MalEnvHandle(env.id)
  if (ast.length != 3) ithen
    result init MalMkError(sprintf("%s: expected 2 arguments, got %d", \
      name, ast.length - 1))
  else
    symbol:MalValue init MalAt(ast, 1)
    valueForm:MalValue init MalAt(ast, 2)

    if (symbol.type != $MAL_SYMBOL_TYPE) ithen
      result init MalMkError(sprintf("%s: first argument must be a symbol", name))
    else
      definitionEnv:MalEnv init MalEnvResolve(currentEnv)
      key:MalValue init MalMkString(symbol.string)
      if (atRoot == 1 || lenarray(definitionEnv.outer) == 0) ithen
        key init MalDefinitionKey(definitionEnv, symbol.string)
        definitionEnv init MalEnvRoot(definitionEnv)
      endif
      definitionInputEnv:MalEnv init MalEnvHandle(currentEnv.id)
      value:MalValue init key
      if (key.type != $MAL_ERROR_TYPE) ithen
        value, currentEnv = MalEvalInternal(valueForm, definitionInputEnv)
      endif

      if (value.type == $MAL_ERROR_TYPE) ithen
        result init value
      elseif (asMacro == 1 && value.type != $MAL_FUNCTION_TYPE) ithen
        result init MalMkError(sprintf("%s: value must be a function", name))
      else
        if (asMacro == 1) ithen
          value init MalFunctionAsMacro(value)
        endif

        definitionEnv init MalEnvSet(definitionEnv, key.string, value)

        if (MalIsFnForm(valueForm) == 1) ithen
          value init MalFunctionCaptureEnv(value, currentEnv)
          definitionEnv init MalEnvSet(definitionEnv, key.string, value)
        endif

        currentEnv init MalEnvResolve(currentEnv)
        result init value
      endif
    endif
  endif

  xout result, currentEnv
endop

opcode MalEvalDef(ast:MalValue, env:MalEnv):(MalValue, MalEnv)
  head:MalValue init MalAt(ast, 0)
  result:MalValue, currentEnv:MalEnv = \
    MalEvalDefinition(ast, env, head.string, 0, MalIsSymbolNamed(head, "def"))
  xout result, currentEnv
endop

opcode MalEvalDefMacro(ast:MalValue, env:MalEnv):(MalValue, MalEnv)
  result:MalValue, currentEnv:MalEnv = \
    MalEvalDefinition(ast, env, "defmacro!", 1, 0)
  xout result, currentEnv
endop

opcode MalParamsAreValid(params:MalValue):i
  valid:i = 1
  restIndex:i = -1

  if (params.type != $MAL_LIST_TYPE && params.type != $MAL_VECTOR_TYPE) ithen
    valid = 0
  elseif (params.length > 0) ithen
    for index in [0 ... params.length - 1] do
      param:MalValue init MalAt(params, index)

      if (param.type != $MAL_SYMBOL_TYPE) ithen
        valid = 0
        break
      elseif (strcmp(param.string, "&") == 0) ithen
        if (restIndex >= 0 || index != params.length - 2) ithen
          valid = 0
          break
        endif

        restIndex = index
      endif
    od
  endif

  xout valid
endop

opcode MalEvalFn(ast:MalValue, env:MalEnv):(MalValue, MalEnv)
  result:MalValue init MalMkValue($MAL_NIL_TYPE)
  currentEnv:MalEnv init MalEnvHandle(env.id)
  if (ast.length != 3) ithen
    result init MalMkError(sprintf("fn*: expected 2 arguments, got %d", \
      ast.length - 1))
  else
    params:MalValue init MalAt(ast, 1)
    body:MalValue init MalAt(ast, 2)

    if (params.type != $MAL_LIST_TYPE && params.type != $MAL_VECTOR_TYPE) ithen
      result init MalMkError("fn*: params must be list or vector")
    elseif (MalParamsAreValid(params) == 0) ithen
      result init MalMkError("fn*: params must be symbols")
    else
      result init MalMkFunction(params, body)
      result init MalFunctionCaptureEnv(result, currentEnv)
    endif
  endif

  xout result, currentEnv
endop

;; Begin src/forms.orc
;; This Source Code Form is subject to the terms of the Mozilla Public
;; License, v. 2.0. If a copy of the MPL was not distributed with this
;; file, You can obtain one at https://mozilla.org/MPL/2.0/.

;; Lower the Clojure forms to the MAL evaluator's single-body forms.
opcode MalBodyForms(ast:MalValue, start:i):MalValue
  result:MalValue init MalMkList1(MalMkSymbol("do"))
  if (ast.length > start) ithen
    for index in [start ... ast.length - 1] do
      result init MalAppendValue(result, MalAt(ast, index))
    od
  endif
  xout result
endop

opcode MalExpandFn(ast:MalValue, paramsIndex:i, name:S):MalValue
  result:MalValue init MalMkError(sprintf("%s: expected a parameter vector and body", name))
  if (ast.length > paramsIndex) ithen
    params:MalValue init MalAt(ast, paramsIndex)
    if (params.type != $MAL_VECTOR_TYPE) ithen
      result init MalMkError(sprintf("%s: params must be a vector", name))
    elseif (MalParamsAreValid(params) == 0) ithen
      result init MalMkError(sprintf("%s: params must be symbols with an optional & rest parameter", name))
    else
      valid:i = 1
      if (params.length > 0) ithen
        for index in [0 ... params.length - 1] do
          param:MalValue init MalAt(params, index)
          if (index > 0) ithen
            for previous in [0 ... index - 1] do
              other:MalValue init MalAt(params, previous)
              if (strcmp(param.string, other.string) == 0) ithen
                valid = 0
              endif
            od
          endif
        od
      endif
      if (valid == 0) ithen
        result init MalMkError(sprintf("%s: parameter names must be distinct", name))
      else
        result init MalMkList3(MalMkSymbol("fn*"), params, MalBodyForms(ast, paramsIndex + 1))
      endif
    endif
  endif
  xout result
endop

opcode MalEvalNamedDefinition(ast:MalValue, env:MalEnv):(MalValue, MalEnv)
  head:MalValue init MalAt(ast, 0)
  currentEnv:MalEnv init env
  result:MalValue init MalMkError(sprintf("%s: expected a name, parameter vector, and body", head.string))
  if (ast.length >= 3) ithen
    name:MalValue init MalAt(ast, 1)
    if (name.type != $MAL_SYMBOL_TYPE) ithen
      result init MalMkError(sprintf("%s: first argument must be a symbol", head.string))
    else
      functionForm:MalValue init MalExpandFn(ast, 2, head.string)
      if (functionForm.type == $MAL_ERROR_TYPE) ithen
        result init functionForm
      else
        definition:MalValue init MalMkList3(head, name, functionForm)
        result, currentEnv = MalEvalDefinition(definition, env, head.string, \
          MalIsSymbolNamed(head, "defmacro"), 1)
      endif
    endif
  endif
  xout result, currentEnv
endop

opcode MalLetBody(ast:MalValue):MalValue
  result:MalValue init MalMkError("let: expected a binding vector and body")
  if (ast.length >= 2) ithen
    bindings:MalValue init MalAt(ast, 1)
    if (bindings.type != $MAL_VECTOR_TYPE) ithen
      result init MalMkError("let: bindings must be a vector")
    elseif (bindings.length % 2 != 0) ithen
      result init MalMkError("let: bindings must contain even number of forms")
    else
      result init MalBodyForms(ast, 2)
      if (bindings.length > 0) ithen
        for index in [0 ... bindings.length / 2 - 1] do
          name:MalValue init MalAt(bindings, index * 2)
          if (name.type != $MAL_SYMBOL_TYPE) ithen
            result init MalMkError("let: binding name must be a symbol")
            break
          endif
        od
      endif
    endif
  endif
  xout result
endop
;; End src/forms.orc


opcode MalEvalIf(ast:MalValue, env:MalEnv):(MalValue, MalEnv)
  result:MalValue init MalMkValue($MAL_NIL_TYPE)
  currentEnv:MalEnv init MalEnvHandle(env.id)
  if (ast.length < 3 || ast.length > 4) ithen
    result init MalMkError(sprintf("if: expected 2 or 3 arguments, got %d", \
      ast.length - 1))
  else
    conditionForm:MalValue init MalAt(ast, 1)
    branchInputEnv:MalEnv init MalEnvHandle(currentEnv.id)
    condition:MalValue, currentEnv = MalEvalInternal(conditionForm, branchInputEnv)

    if (condition.type == $MAL_ERROR_TYPE) ithen
      result init condition
    elseif (MalIsTruthy(condition) == 1) ithen
      thenForm:MalValue init MalAt(ast, 2)
      branchInputEnv init MalEnvHandle(currentEnv.id)
      result, currentEnv = MalEvalInternal(thenForm, branchInputEnv)
    elseif (ast.length == 4) ithen
      elseForm:MalValue init MalAt(ast, 3)
      branchInputEnv init MalEnvHandle(currentEnv.id)
      result, currentEnv = MalEvalInternal(elseForm, branchInputEnv)
    endif
  endif

  xout result, currentEnv
endop

opcode MalEvalDo(ast:MalValue, env:MalEnv):(MalValue, MalEnv)
  result:MalValue init MalMkValue($MAL_NIL_TYPE)
  currentEnv:MalEnv init MalEnvHandle(env.id)
  index:i = 1
  done:i = 0

  while (index < ast.length && done == 0) do
    form:MalValue init MalAt(ast, index)
    formInputEnv:MalEnv init MalEnvHandle(currentEnv.id)
    result, currentEnv = MalEvalInternal(form, formInputEnv)

    if (result.type == $MAL_ERROR_TYPE) ithen
      done = 1
    endif

    index += 1
  od

  xout result, currentEnv
endop

opcode MalEvalLet(ast:MalValue, env:MalEnv):(MalValue, MalEnv)
  result:MalValue init MalMkValue($MAL_NIL_TYPE)
  currentEnv:MalEnv init MalEnvHandle(env.id)
  letEnv:MalEnv init MalMkEnvWithOuter(env)

  if (ast.length != 3) ithen
    result init MalMkError(sprintf("let*: expected 2 arguments, got %d", \
      ast.length - 1))
  else
    bindings:MalValue init MalAt(ast, 1)
    body:MalValue init MalAt(ast, 2)

    if (bindings.type != $MAL_LIST_TYPE && \
        bindings.type != $MAL_VECTOR_TYPE) ithen
      result init MalMkError("let*: bindings must be list or vector")
    elseif (bindings.length % 2 != 0) ithen
      result init MalMkError("let*: bindings must contain even number of forms")
    else
      index:i = 0
      done:i = 0

      while (index < bindings.length && done == 0) do
        name:MalValue init MalAt(bindings, index)
        valueForm:MalValue init MalAt(bindings, index + 1)

        if (name.type != $MAL_SYMBOL_TYPE) ithen
          result init MalMkError("let*: binding name must be a symbol")
          done = 1
        else
          letInputEnv:MalEnv init MalEnvHandle(letEnv.id)
          value:MalValue, letEnv = MalEvalInternal(valueForm, letInputEnv)

          if (value.type == $MAL_ERROR_TYPE) ithen
            result init value
            done = 1
          else
            letEnv init MalEnvSet(letEnv, name.string, value)

            index += 2
          endif
        endif
      od

      if (done == 0) ithen
        letInputEnv init MalEnvHandle(letEnv.id)
        result, letEnv = MalEvalInternal(body, letInputEnv)
      endif
    endif
  endif

  MalEnvRelease(letEnv)

  xout result, currentEnv
endop

;; Internal calls carry registry handles. The public evaluator resolves its
;; returned environment once, instead of copying all bindings at every form.
opcode MalEvalInternal(ast:MalValue, env:MalEnv):(MalValue, MalEnv)
  result:MalValue init ast
  workAst:MalValue init ast
  evalEnv:MalEnv init MalEnvHandle(env.id)
  returnEnv:MalEnv init MalEnvHandle(env.id)
  recursiveInputEnv:MalEnv init MalEnvHandle(env.id)
  transientEnvIds:i[] init 0
  transientEnvCount:i = 0
  done:i = 0

  while (done == 0) do
    transientEnvId:i = -1
    if (malDebugEvalBindingSeen == 1) ithen
      debugValue:MalValue init MalResolveSymbol(evalEnv, "DEBUG-EVAL")
      if (debugValue.type != $MAL_ERROR_TYPE) ithen
        if (MalIsTruthy(debugValue) == 1) ithen
          SdebugAst:S init pr_str(workAst)
          prints "EVAL: %s\n", SdebugAst
        endif
      endif
    endif

    if (workAst.type == $MAL_LIST_TYPE && workAst.length > 0) ithen
      head:MalValue init MalAt(workAst, 0)

      if (MalIsSymbolNamed(head, "ns") == 1) ithen
        result init MalEvalNamespace(workAst, evalEnv)
        evalEnv init MalEnvResolve(evalEnv)
        done = 1

      elseif (MalIsSymbolNamed(head, "quote") == 1) ithen
        result init MalEvalQuote(workAst)
        done = 1

      elseif (MalIsSymbolNamed(head, "quasiquote") == 1) ithen
        if (workAst.length != 2) ithen
          result init MalArityError("quasiquote", 1, workAst.length - 1)
          done = 1
        else
          workAst init MalQuasiquote(MalAt(workAst, 1))

          if (workAst.type == $MAL_ERROR_TYPE) ithen
            result init workAst
            done = 1
          endif
        endif

      elseif (MalIsSymbolNamed(head, "def") == 1 || MalIsSymbolNamed(head, "def!") == 1) ithen
        recursiveInputEnv init MalEnvHandle(evalEnv.id)
        result, evalEnv = MalEvalDef(workAst, recursiveInputEnv)
        done = 1

      elseif (MalIsSymbolNamed(head, "defmacro!") == 1) ithen
        recursiveInputEnv init MalEnvHandle(evalEnv.id)
        result, evalEnv = MalEvalDefMacro(workAst, recursiveInputEnv)
        done = 1

      elseif (MalIsSymbolNamed(head, "defn") == 1 || MalIsSymbolNamed(head, "defmacro") == 1) ithen
        recursiveInputEnv init MalEnvHandle(evalEnv.id)
        result, evalEnv = MalEvalNamedDefinition(workAst, recursiveInputEnv)
        done = 1

      elseif (MalIsSymbolNamed(head, "fn") == 1) ithen
        workAst init MalExpandFn(workAst, 1, "fn")
        if (workAst.type == $MAL_ERROR_TYPE) ithen
          result init workAst
          done = 1
        endif

      elseif (head.type == $MAL_SYMBOL_TYPE && strcmp(head.string, "fn*") == 0) ithen
        recursiveInputEnv init MalEnvHandle(evalEnv.id)
        result, evalEnv = MalEvalFn(workAst, recursiveInputEnv)
        done = 1

      elseif (MalIsSymbolNamed(head, "try*") == 1) ithen
        tryArgCount:i = workAst.length - 1

        if (tryArgCount < 1 || tryArgCount > 2) ithen
          result init MalMkError(sprintf( \
            "try*: expected 1 or 2 arguments, got %d", tryArgCount))
          done = 1
        elseif (tryArgCount == 1) ithen
          workAst init MalAt(workAst, 1)
        else
          catchClause:MalValue init MalAt(workAst, 2)

          if (MalIsForm(catchClause, "catch*") == 0 || \
              catchClause.length != 3) ithen
            result init MalMkError( \
              "try*: second argument must be (catch* symbol handler)")
            done = 1
          else
            catchBinding:MalValue init MalAt(catchClause, 1)

            if (catchBinding.type != $MAL_SYMBOL_TYPE) ithen
              result init MalMkError("catch*: binding must be a symbol")
              done = 1
            else
              tryForm:MalValue init MalAt(workAst, 1)
              recursiveInputEnv init MalEnvHandle(evalEnv.id)
              tryResult:MalValue, evalEnv = MalEvalInternal( \
                tryForm, recursiveInputEnv)

              if (tryResult.type == $MAL_ERROR_TYPE) ithen
                catchEnv:MalEnv init MalMkEnvWithOuter(evalEnv)
                transientEnvId = catchEnv.id
                catchValue:MalValue init MalErrorPayload(tryResult)
                catchEnv init MalEnvSet( \
                  catchEnv, catchBinding.string, catchValue)
                workAst init MalAt(catchClause, 2)
                evalEnv init MalEnvHandle(catchEnv.id)
              else
                result init tryResult
                done = 1
              endif
            endif
          endif
        endif

      elseif (head.type == $MAL_SYMBOL_TYPE && strcmp(head.string, "if") == 0) ithen
        if (workAst.length < 3 || workAst.length > 4) ithen
          result init MalMkError(sprintf("if: expected 2 or 3 arguments, got %d", \
            workAst.length - 1))
          done = 1
        else
          ifConditionForm:MalValue init MalAt(workAst, 1)
          recursiveInputEnv init MalEnvHandle(evalEnv.id)
          ifCondition:MalValue, evalEnv = MalEvalInternal( \
            ifConditionForm, recursiveInputEnv)

          if (ifCondition.type == $MAL_ERROR_TYPE) ithen
            result init ifCondition
            done = 1
          elseif (MalIsTruthy(ifCondition) == 1) ithen
            workAst init MalAt(workAst, 2)
          elseif (workAst.length == 4) ithen
            workAst init MalAt(workAst, 3)
          else
            result init MalMkValue($MAL_NIL_TYPE)
            done = 1
          endif
        endif

      elseif (head.type == $MAL_SYMBOL_TYPE && strcmp(head.string, "do") == 0) ithen
        if (workAst.length == 1) ithen
          result init MalMkValue($MAL_NIL_TYPE)
          done = 1
        else
          doIndex:i = 1
          doError:i = 0
          doLastIndex:i = workAst.length - 1

          while (doIndex < doLastIndex && doError == 0) do
            doForm:MalValue init MalAt(workAst, doIndex)
            recursiveInputEnv init MalEnvHandle(evalEnv.id)
            result, evalEnv = MalEvalInternal(doForm, recursiveInputEnv)

            if (result.type == $MAL_ERROR_TYPE) ithen
              doError = 1
              done = 1
            endif

            doIndex += 1
          od

          if (doError == 0) ithen
            workAst init MalAt(workAst, doLastIndex)
          endif
        endif

      elseif (MalIsSymbolNamed(head, "let*") == 1 || MalIsSymbolNamed(head, "let") == 1) ithen
        immutableLet:i = MalIsSymbolNamed(head, "let")
        if (immutableLet == 1) ithen
          ;; Validate every binding before running any of their value forms.
          body:MalValue init MalLetBody(workAst)
          if (body.type == $MAL_ERROR_TYPE) ithen
            result init body
            done = 1
          else
            workAst init MalMkList3(head, MalAt(workAst, 1), body)
          endif
        endif
        letEnv:MalEnv init MalMkEnvWithOuter(evalEnv)
        transientEnvIds, transientEnvCount = MalEnvTrack( \
          transientEnvIds, transientEnvCount, letEnv.id)

        if (done == 1) ithen
          ;; Keep the validation error; the new scope will be released below.
        elseif (workAst.length != 3) ithen
          result init MalMkError(sprintf("let*: expected 2 arguments, got %d", \
            workAst.length - 1))
          done = 1
        else
          letBindings:MalValue init MalAt(workAst, 1)
          letBody:MalValue init MalAt(workAst, 2)

          if (letBindings.type != $MAL_LIST_TYPE && \
              letBindings.type != $MAL_VECTOR_TYPE) ithen
            result init MalMkError("let*: bindings must be list or vector")
            done = 1
          elseif (letBindings.length % 2 != 0) ithen
            result init MalMkError("let*: bindings must contain even number of forms")
            done = 1
          else
            letIndex:i = 0
            letError:i = 0

            while (letIndex < letBindings.length && letError == 0) do
              letName:MalValue init MalAt(letBindings, letIndex)
              letValueForm:MalValue init MalAt(letBindings, letIndex + 1)

              if (letName.type != $MAL_SYMBOL_TYPE) ithen
                result init MalMkError("let*: binding name must be a symbol")
                letError = 1
                done = 1
              else
                recursiveInputEnv init MalEnvHandle(letEnv.id)
                letValue:MalValue, letEnv = MalEvalInternal( \
                  letValueForm, recursiveInputEnv)

                if (letValue.type == $MAL_ERROR_TYPE) ithen
                  result init letValue
                  letError = 1
                  done = 1
                else
                  if (immutableLet == 1) ithen
                    ;; Bind after evaluating in the preceding scope. Closures
                    ;; keep earlier values even when a later name shadows one.
                    letEnv init MalMkEnvWithOuter(letEnv)
                    transientEnvIds, transientEnvCount = MalEnvTrack( \
                      transientEnvIds, transientEnvCount, letEnv.id)
                  endif
                  letEnv init MalEnvSet(letEnv, letName.string, letValue)

                  letIndex += 2
                endif
              endif
            od

            if (letError == 0) ithen
              workAst init letBody
              evalEnv init MalEnvHandle(letEnv.id)
            endif
          endif
        endif

      else
        recursiveInputEnv init MalEnvHandle(evalEnv.id)
        fn:MalValue, evalEnv = MalEvalInternal(head, recursiveInputEnv)

        if (fn.type == $MAL_ERROR_TYPE) ithen
          result init fn
          done = 1
        elseif (MalIsMacro(fn) == 1) ithen
          rawArgs:MalValue init MalUnevaluatedArgs(workAst)
          expansion:MalValue init MalApplyFunction(fn, rawArgs)

          if (expansion.type == $MAL_ERROR_TYPE) ithen
            result init expansion
            done = 1
          else
            workAst init expansion
          endif
        else
          recursiveInputEnv init MalEnvHandle(evalEnv.id)
          args:MalValue, evalEnv = MalEvalSequenceEnv( \
            workAst, recursiveInputEnv, 1, $MAL_LIST_TYPE)

          if (args.type == $MAL_ERROR_TYPE) ithen
            result init args
            done = 1
          elseif (fn.type == $MAL_BUILTIN_TYPE && strcmp(fn.string, "eval") == 0) ithen
            if (args.length != 1) ithen
              result init MalArityError(fn.string, 1, args.length)
              done = 1
            else
              evalAst:MalValue init MalAt(args, 0)
              evalRoot:MalEnv init MalEnvRoot(evalEnv)
              recursiveInputEnv init MalEnvHandle(evalRoot.id)
              result, evalRoot = MalEvalInternal(evalAst, recursiveInputEnv)
              evalEnv init MalEnvSetRoot(evalEnv, evalRoot)

              done = 1
            endif
          elseif (fn.type == $MAL_FUNCTION_TYPE) ithen
            bindStatus:MalValue, callEnv:MalEnv = MalBindFunctionEnv(fn, args)

            if (bindStatus.type == $MAL_ERROR_TYPE) ithen
              result init bindStatus
              done = 1
            else
              transientEnvId = callEnv.id
              workAst init MalFunctionBody(fn)
              evalEnv init MalEnvHandle(callEnv.id)
            endif
          else
            result init MalApply(fn, args)
            done = 1
          endif
        endif
      endif
    else
      recursiveInputEnv init MalEnvHandle(evalEnv.id)
      result, evalEnv = MalEvalAstEnv(workAst, recursiveInputEnv)

      done = 1
    endif

    if (transientEnvId >= 0) ithen
      transientEnvIds, transientEnvCount = MalEnvTrack( \
        transientEnvIds, transientEnvCount, transientEnvId)
    endif
  od

  returnEnv init MalEnvHandle(returnEnv.id)

  if (transientEnvCount > 0) ithen
    for releaseIndex in [0 ... transientEnvCount - 1] do
      reverseIndex:i = transientEnvCount - releaseIndex - 1
      envId:i = transientEnvIds[reverseIndex]
      MalEnvRelease(MalEnvHandle(envId))
    od
  endif

  xout result, returnEnv
endop

opcode EVAL_ENV(ast:MalValue, env:MalEnv):(MalValue, MalEnv)
  handle:MalEnv init MalEnvHandle(env.id)
  result:MalValue, nextEnv:MalEnv = MalEvalInternal(ast, handle)
  updated:MalEnv init MalEnvResolve(nextEnv)
  xout result, updated
endop

opcode EVAL(ast:MalValue, env:MalEnv):MalValue
  result:MalValue, updatedEnv:MalEnv = MalEvalInternal(ast, env)
  xout result
endop

opcode MalEvalSourceEnv(source:S, env:MalEnv):(MalValue, MalEnv)
  ast:MalValue init read_str(source)
  currentEnv:MalEnv init MalEnvHandle(env.id)
  if (ast.type == $MAL_ERROR_TYPE) ithen
    result:MalValue init ast
  else
    sourceInputEnv:MalEnv init MalEnvHandle(currentEnv.id)
    result, currentEnv = MalEvalInternal(ast, sourceInputEnv)
  endif

  xout result, MalEnvResolve(currentEnv)
endop

;; Read every form before evaluation, since read-string and load-file reuse
;; the reader's token storage. A region behaves like a top-level do form.
opcode MalEvalFormsEnv(source:S, env:MalEnv):(MalValue, MalEnv)
  ast:MalValue init MalMkList1(MalMkSymbol("do"))
  tokens:MalTokens init tokenize(source)
  if (tokens.length > 0) ithen
    reader:MalReader init MalMkReader(tokens)
    while (reader.done == 0 && ast.type != $MAL_ERROR_TYPE) do
      form:MalReadResult init read_form(reader)
      value:MalValue init MalReadResultValue(form)
      reader init MalReadResultReader(form)
      if (value.type == $MAL_ERROR_TYPE) ithen
        ast init value
      else
        ast init MalAppendValue(ast, value)
      endif
    od
  endif
  nextEnv:MalEnv init MalEnvHandle(env.id)
  if (ast.type == $MAL_ERROR_TYPE) ithen
    result:MalValue init ast
  else
    result, nextEnv = MalEvalInternal(ast, env)
  endif
  xout result, MalEnvResolve(nextEnv)
endop

;; Begin src/threading.orc
;; This Source Code Form is subject to the terms of the Mozilla Public
;; License, v. 2.0. If a copy of the MPL was not distributed with this
;; file, You can obtain one at https://mozilla.org/MPL/2.0/.

opcode MalInstallThreadingMacros(env:MalEnv):MalEnv
  source:S init {{
(do
  (defn threading/step [last? value form]
    (if (list? form)
      (with-meta
        (if last?
          (concat form (list value))
          (cons (first form) (cons value (rest form))))
        (meta form))
      (list form value)))

  (defn threading/expand [last? value forms]
    (if (empty? forms)
      value
      (threading/expand last?
                        (threading/step last? value (first forms))
                        (rest forms))))

  (defn threading/some [last? value forms]
    (if (empty? forms)
      value
      (let* [name (gensym)]
        (list 'let* (list name value)
              (list 'if (list nil? name) nil
                    (threading/some last?
                                    (threading/step last? name (first forms))
                                    (rest forms)))))))

  (defn threading/cond [last? value clauses]
    (if (empty? clauses)
      value
      (if (= (count clauses) 1)
        (throw "conditional threading requires test/form pairs")
        (let* [name (gensym)]
          (list 'let* (list name value)
                (threading/cond last?
                                (list 'if (first clauses)
                                      (threading/step last? name (nth clauses 1))
                                      name)
                                (rest (rest clauses))))))))

  (defn threading/as [value name forms]
    (if (empty? forms)
      value
      ;; Evaluate the value before binding its name, so closures created
      ;; by a step retain the preceding binding.
      ;; Use a fresh parameter because fn* reserves & for rest arguments.
      (let* [parameter (gensym)]
        (list (list 'fn* (list parameter)
                    (list 'let* (list name parameter)
                          (threading/as (first forms) name (rest forms))))
              value))))

  (defmacro -> [value & forms] (threading/expand false value forms))
  (defmacro ->> [value & forms] (threading/expand true value forms))
  (defmacro some-> [value & forms] (threading/some false value forms))
  (defmacro some->> [value & forms] (threading/some true value forms))
  (defmacro cond-> [value & clauses] (threading/cond false value clauses))
  (defmacro cond->> [value & clauses] (threading/cond true value clauses))

  (defmacro as-> [value name & forms]
    (if (symbol? name)
      (threading/as value name forms)
      (throw "as->: binding name must be a symbol"))))
}}
  result:MalValue, currentEnv:MalEnv = MalEvalSourceEnv(source, env)

  if (result.type == $MAL_ERROR_TYPE) ithen
    prints "threading macro bootstrap failed: %s\n", result.string
  endif

  xout currentEnv
endop
;; End src/threading.orc


opcode MalMkStep6Env():MalEnv
  env:MalEnv init MalMkStep2Env()
  env init MalEnvSet(env, "*ARGV*", MalMkValue($MAL_LIST_TYPE))
  source:S init "(defn load-file [f] (eval (read-string (str \"(do \" (slurp f) \"\\nnil)\"))))"
  result:MalValue, env = MalEvalSourceEnv(source, env)

  if (result.type == $MAL_ERROR_TYPE) ithen
    prints "load-file bootstrap failed: %s\n", result.string
  endif

  xout env
endop

opcode MalMkStep8Env():MalEnv
  env:MalEnv init MalMkStep6Env()
  source:S init "(defmacro cond [& xs] (if (> (count xs) 0) "
  source strcat source, "(list 'if (first xs) "
  source strcat source, "(if (> (count xs) 1) (nth xs 1) "
  source strcat source, "(throw \"odd number of forms to cond\")) "
  source strcat source, "(cons 'cond (rest (rest xs))))))"
  result:MalValue, env = MalEvalSourceEnv(source, env)

  if (result.type == $MAL_ERROR_TYPE) ithen
    prints "cond bootstrap failed: %s\n", result.string
  endif

  xout env
endop

opcode MalMkStep9Env():MalEnv
  env:MalEnv init MalMkStep8Env()
  env init MalEnvSet(env, "throw", MalMkBuiltin("throw"))
  env init MalEnvSet(env, "apply", MalMkBuiltin("apply"))
  env init MalEnvSet(env, "map", MalMkBuiltin("map"))
  env init MalEnvSet(env, "nil?", MalMkBuiltin("nil?"))
  env init MalEnvSet(env, "true?", MalMkBuiltin("true?"))
  env init MalEnvSet(env, "false?", MalMkBuiltin("false?"))
  env init MalEnvSet(env, "symbol", MalMkBuiltin("symbol"))
  env init MalEnvSet(env, "symbol?", MalMkBuiltin("symbol?"))
  env init MalEnvSet(env, "keyword", MalMkBuiltin("keyword"))
  env init MalEnvSet(env, "keyword?", MalMkBuiltin("keyword?"))
  env init MalEnvSet(env, "vector", MalMkBuiltin("vector"))
  env init MalEnvSet(env, "vector?", MalMkBuiltin("vector?"))
  env init MalEnvSet(env, "sequential?", MalMkBuiltin("sequential?"))
  env init MalEnvSet(env, "hash-map", MalMkBuiltin("hash-map"))
  env init MalEnvSet(env, "map?", MalMkBuiltin("map?"))
  env init MalEnvSet(env, "assoc", MalMkBuiltin("assoc"))
  env init MalEnvSet(env, "dissoc", MalMkBuiltin("dissoc"))
  env init MalEnvSet(env, "get", MalMkBuiltin("get"))
  env init MalEnvSet(env, "contains?", MalMkBuiltin("contains?"))
  env init MalEnvSet(env, "keys", MalMkBuiltin("keys"))
  env init MalEnvSet(env, "vals", MalMkBuiltin("vals"))
  env init MalEnvSet(env, "pr-str", MalMkBuiltin("pr-str"))
  env init MalRefreshTopLevelFunctionClosures(env)
  xout env
endop

opcode MalMkStepAEnv():MalEnv
  env:MalEnv init MalMkStep9Env()
  env init MalEnvSet(env, "gensym", MalMkBuiltin("gensym"))
  env init MalEnvSet(env, "meta", MalMkBuiltin("meta"))
  env init MalEnvSet(env, "with-meta", MalMkBuiltin("with-meta"))
  env init MalEnvSet(env, "string?", MalMkBuiltin("string?"))
  env init MalEnvSet(env, "number?", MalMkBuiltin("number?"))
  env init MalEnvSet(env, "fn?", MalMkBuiltin("fn?"))
  env init MalEnvSet(env, "seq", MalMkBuiltin("seq"))
  env init MalEnvSet(env, "conj", MalMkBuiltin("conj"))
  env init MalEnvSet(env, "time-ms", MalMkBuiltin("time-ms"))
  env init MalEnvSet(env, "println", MalMkBuiltin("println"))
  env init MalEnvSet(env, "readline", MalMkBuiltin("readline"))
  source:S init "(def *host-language* \"Csound7\")"
  result:MalValue, env = MalEvalSourceEnv(source, env)

  if (result.type == $MAL_ERROR_TYPE) ithen
    prints "host language bootstrap failed: %s\n", result.string
  endif

  env init MalInstallCoreHelpers(env)
  env init MalInstallThreadingMacros(env)
  env init MalInstallNamespaces(env)
  xout env
endop

opcode MalMkCsoundEnv():MalEnv
  env:MalEnv init MalMkStepAEnv()
  csoundNs:i = MalNsEnsure(env, "csound", 1)
  malNamespaces[csoundNs].status = 1
  env init MalEnvSet(env, "csound-eval", MalMkBuiltin("csound-eval"))
  env init MalEnvSet(env, "csound/param-bindings", \
    MalMkBuiltin("csound/param-bindings"))
  env init MalEnvSet(env, "csound/compile-inst", \
    MalMkBuiltin("csound/compile-inst"))
  env init MalEnvSet(env, "csound/event", MalMkBuiltin("csound/event"))
  env init MalEnvSet(env, "csound/do", MalMkBuiltin("csound/do"))
  env init MalEnvSet(env, "csound/eval", MalMkBuiltin("csound/eval"))
  env init MalEnvSet(env, "csound/at-rate", MalMkBuiltin("csound/at-rate"))
  env init MalEnvSet(env, "csound/array", MalMkBuiltin("csound/array"))
  env init MalEnvSet(env, "csound/aget", MalMkBuiltin("csound/aget"))
  env init MalEnvSet(env, "csound/outputs", MalMkBuiltin("csound/outputs"))
  env init MalEnvSet(env, "csound/type", MalMkBuiltin("csound/type"))
  env init MalEnvSet(env, "csound/source", MalMkBuiltin("csound/source"))
  env init MalCsoundInstallOpcodes(env)

  env init MalNsSwitch(env, "csound")
  source:S init "(defmacro definst [name params body] (let* [compiled (list 'csound/compile-inst (list 'quote name) (list 'quote params) (list 'let* (csound/param-bindings params) body))] (if (number? name) compiled (list 'def name compiled))))"
  result:MalValue, env = MalEvalSourceEnv(source, env)
  env init MalNsSwitch(env, "user")

  if (result.type == $MAL_ERROR_TYPE) ithen
    prints "definst bootstrap failed: %s\n", result.string
  endif

  ;; Compatibility alias; new programs use the qualified macro.
  env init MalEnvSet(env, "definst", MalEnvGet(env, "csound/definst"))

  xout env
endop
;; End src/eval.orc

;; Begin src/eval-job.orc
;; This Source Code Form is subject to the terms of the Mozilla Public
;; License, v. 2.0. If a copy of the MPL was not distributed with this
;; file, You can obtain one at https://mozilla.org/MPL/2.0/.

;; A job saves evaluator continuations between init passes. Each step runs at
;; most its budget of transitions; builtins run one native operation at a
;; time. Jobs share ordinary environments and atoms, so writes remain visible
;; between steps. Cancellation releases scopes; it does not undo writes.
;; Core frames: 1 collection/arguments, 2 if, 3 do, 4 let binding, 5 call
;; head, 6 definition, 7 try, 8 macro expansion, 9 scope cleanup. Builtin
;; continuations use kinds 100 and above.
struct MalEvalFrame kind:i, env:i, form:MalValue, data:MalValue, aux:MalValue, extra:MalValue, index:i, limit:i, flag:i
struct MalEvalJob id:i, status:i, env:i, mode:i, top:i, depth:i

malEvalJobs@global:MalEvalJob[] init 16
malEvalJobNextId@global:i init 1
;; Keep payloads in parallel arrays: Csound cannot assign a nested UDT member
;; of a struct-array element directly. Scalars in MalEvalJob need no copies.
malEvalJobAsts@global:MalValue[] init 16
malEvalJobValues@global:MalValue[] init 16
malEvalJobFunctions@global:MalValue[] init 16
malEvalJobArguments@global:MalValue[] init 16
malEvalJobFrames@global:MalEvalFrame[] init 256
malEvalJobFrameNext@global:i[] init 256
malEvalJobFrameCount@global:i init 0
malEvalJobFrameFree@global:i init -1

opcode MalEvalJobSlot(id:i):i
  result:i = -1
  if (id > 0) ithen
    for slot in [0 ... lenarray(malEvalJobs) - 1] do
      if (malEvalJobs[slot].id == id) ithen
        result = slot
        break
      endif
    od
  endif
  xout result
endop

opcode MalEvalJobPush(slot:i, frame:MalEvalFrame):void
  index:i = malEvalJobFrameFree
  if (index >= 0) ithen
    malEvalJobFrameFree = malEvalJobFrameNext[index]
  else
    index = malEvalJobFrameCount
    capacity:i = lenarray(malEvalJobFrames)
    if (index >= capacity) ithen
      saved:MalEvalFrame[] init capacity
      links:i[] init capacity
      for offset in [0 ... capacity - 1] do
        saved[offset] init malEvalJobFrames[offset]
        links[offset] = malEvalJobFrameNext[offset]
      od
      malEvalJobFrames init capacity * 2
      malEvalJobFrameNext init capacity * 2
      for offset in [0 ... capacity - 1] do
        malEvalJobFrames[offset] init saved[offset]
        malEvalJobFrameNext[offset] = links[offset]
      od
    endif
    malEvalJobFrameCount += 1
  endif
  malEvalJobFrames[index] init frame
  malEvalJobFrameNext[index] = malEvalJobs[slot].top
  malEvalJobs[slot].top = index
  malEvalJobs[slot].depth = malEvalJobs[slot].depth + 1
endop

opcode MalEvalJobPop(slot:i):MalEvalFrame
  index:i = malEvalJobs[slot].top
  frame:MalEvalFrame init malEvalJobFrames[index]
  malEvalJobs[slot].top = malEvalJobFrameNext[index]
  malEvalJobs[slot].depth = malEvalJobs[slot].depth - 1
  malEvalJobFrameNext[index] = malEvalJobFrameFree
  malEvalJobFrameFree = index
  empty:MalEvalFrame init 0, 0, MalMkValue($MAL_NIL_TYPE), MalMkValue($MAL_NIL_TYPE), MalMkValue($MAL_NIL_TYPE), MalMkValue($MAL_NIL_TYPE), 0, 0, 0
  malEvalJobFrames[index] init empty
  xout frame
endop

opcode MalEvalJobOwnEnv(slot:i, id:i):void
  frame:MalEvalFrame init 9, id, MalMkValue($MAL_NIL_TYPE), MalMkValue($MAL_NIL_TYPE), MalMkValue($MAL_NIL_TYPE), MalMkValue($MAL_NIL_TYPE), 0, 0, 0
  MalEvalJobPush(slot, frame)
endop

opcode MalEvalJobSetEval(slot:i, ast:MalValue, env:i):void
  malEvalJobAsts[slot] init ast
  malEvalJobs[slot].env = env
  malEvalJobs[slot].mode = 0
endop

opcode MalEvalJobSetApply(slot:i, fn:MalValue, args:MalValue):void
  malEvalJobFunctions[slot] init fn
  malEvalJobArguments[slot] init args
  malEvalJobs[slot].mode = 2
endop

opcode MalEvalJobReturn(slot:i, value:MalValue):void
  malEvalJobValues[slot] init value
  malEvalJobs[slot].mode = 1
endop

opcode MalEvalJobFail(slot:i, message:S):void
  MalEvalJobReturn(slot, MalMkError(message))
endop

;; Loading an unseen module would enter the synchronous evaluator. Already
;; loaded libraries can safely install aliases and refers in a job.
opcode MalEvalJobRequireReady(env:MalEnv, specs:MalValue):MalValue
  result:MalValue init MalMkValue($MAL_NIL_TYPE)
  root:MalEnv init MalEnvRoot(env)
  if (specs.length > 0) ithen
    for index in [0 ... specs.length - 1] do
      result init MalRequireSpecValid(MalAt(specs, index))
      if (result.type == $MAL_ERROR_TYPE) ithen
        break
      endif
    od
    if (result.type != $MAL_ERROR_TYPE) ithen
      for index in [0 ... specs.length - 1] do
        library:MalValue init MalAt(specs, index)
        if (library.type == $MAL_VECTOR_TYPE) ithen
          library init MalAt(library, 0)
        endif
        nsIndex:i = MalNsFind(root.id, library.string)
        if (nsIndex < 0) ithen
          result init MalMkError(sprintf("require: load '%s' before starting an evaluation job", library.string))
        elseif (malNamespaces[nsIndex].status != 1) ithen
          result init MalMkError(sprintf("require: load '%s' before starting an evaluation job", library.string))
        endif
        if (result.type == $MAL_ERROR_TYPE) ithen
          break
        endif
      od
    endif
  endif
  xout result
endop

opcode MalEvalJobNamespace(ast:MalValue, env:MalEnv):MalValue
  result:MalValue init MalMkValue($MAL_NIL_TYPE)
  specs:MalValue init MalMkValue($MAL_LIST_TYPE)
  valid:i = 0
  root:MalEnv init MalEnvRoot(env)
  if (ast.length >= 2 && strlen(root.namespace) > 0) ithen
    valid = MalNsNameValid(MalAt(ast, 1))
  endif
  ;; Syntax errors must win over a later module-load check, as in ns itself.
  if (valid == 1 && ast.length > 2) ithen
    for index in [2 ... ast.length - 1] do
      clause:MalValue init MalAt(ast, index)
      if (clause.type != $MAL_LIST_TYPE || clause.length == 0) ithen
        valid = 0
      else
        head:MalValue init MalAt(clause, 0)
        if (head.type != $MAL_KEYWORD_TYPE || strcmp(head.string, "require") != 0) ithen
          valid = 0
        elseif (clause.length > 1) ithen
          for item in [1 ... clause.length - 1] do
            spec:MalValue init MalAt(clause, item)
            check:MalValue init MalRequireSpecValid(spec)
            if (check.type == $MAL_ERROR_TYPE) ithen
              valid = 0
              break
            endif
            specs init MalAppendValue(specs, spec)
          od
        endif
      endif
      if (valid == 0) ithen
        break
      endif
    od
  endif
  if (valid == 1) ithen
    result init MalEvalJobRequireReady(root, specs)
  endif
  if (result.type != $MAL_ERROR_TYPE) ithen
    result init MalEvalNamespace(ast, env)
  endif
  xout result
endop

opcode MalEvalJobDefine(slot:i, ast:MalValue, asMacro:i, atRoot:i):void
  head:MalValue init MalAt(ast, 0)
  if (ast.length != 3) ithen
    MalEvalJobReturn(slot, MalArityError(head.string, 2, ast.length - 1))
  else
    name:MalValue init MalAt(ast, 1)
    if (name.type != $MAL_SYMBOL_TYPE) ithen
      MalEvalJobFail(slot, sprintf("%s: first argument must be a symbol", head.string))
    else
      env:MalEnv init MalEnvResolve(MalEnvHandle(malEvalJobs[slot].env))
      definitionEnv:MalEnv init env
      key:MalValue init MalMkString(name.string)
      if (atRoot == 1 || lenarray(env.outer) == 0) ithen
        key init MalDefinitionKey(env, name.string)
        definitionEnv init MalEnvRoot(env)
      endif
      if (key.type == $MAL_ERROR_TYPE) ithen
        MalEvalJobReturn(slot, key)
      else
        frame:MalEvalFrame init 0, 0, MalMkValue($MAL_NIL_TYPE), MalMkValue($MAL_NIL_TYPE), MalMkValue($MAL_NIL_TYPE), MalMkValue($MAL_NIL_TYPE), 0, 0, 0
        frame.kind = 6
        frame.env = env.id
        frame.form init MalAt(ast, 2)
        frame.data init key
        frame.aux init head
        frame.index = definitionEnv.id
        frame.flag = asMacro
        MalEvalJobPush(slot, frame)
        MalEvalJobSetEval(slot, frame.form, env.id)
      endif
    endif
  endif
endop

opcode MalEvalJobLetNext(slot:i, frame:MalEvalFrame):void
  if (frame.index >= frame.data.length) ithen
    MalEvalJobSetEval(slot, frame.form, frame.env)
  else
    name:MalValue init MalAt(frame.data, frame.index)
    if (name.type != $MAL_SYMBOL_TYPE) ithen
      MalEvalJobFail(slot, "let*: binding name must be a symbol")
    else
      MalEvalJobPush(slot, frame)
      MalEvalJobSetEval(slot, MalAt(frame.data, frame.index + 1), frame.env)
    endif
  endif
endop

;; Begin src/eval-job-builtins.orc
;; This Source Code Form is subject to the terms of the Mozilla Public
;; License, v. 2.0. If a copy of the MPL was not distributed with this
;; file, You can obtain one at https://mozilla.org/MPL/2.0/.

;; Each application below returns to the job dispatcher before running Lisp.
;; Frames 100-108 belong to these builtin continuations.
opcode MalEvalJobBuiltinContinue(slot:i, frame:MalEvalFrame):void
  malEvalJobs[slot].env = frame.env
  if (frame.index >= frame.limit) ithen
    if (frame.kind == 103) ithen
      name:S init frame.extra.string
      if (strcmp(name, "every?") == 0 || strcmp(name, "not-any?") == 0) ithen
        MalEvalJobReturn(slot, MalMkBool(1))
      elseif (strcmp(name, "not-every?") == 0) ithen
        MalEvalJobReturn(slot, MalMkBool(0))
      elseif (strcmp(name, "some") == 0) ithen
        MalEvalJobReturn(slot, MalMkValue($MAL_NIL_TYPE))
      else
        MalEvalJobReturn(slot, frame.data)
      endif
    else
      MalEvalJobReturn(slot, frame.data)
    endif
  else
    MalEvalJobPush(slot, frame)
    if (frame.kind == 100) ithen
      MalEvalJobSetApply(slot, frame.form, MalMkList1(MalAt(frame.aux, frame.index)))
    elseif (frame.kind == 101) ithen
      callArgs:MalValue init MalMkValue($MAL_LIST_TYPE)
      for column in [0 ... frame.aux.length - 1] do
        callArgs init MalAppendValue(callArgs, MalAt(MalAt(frame.aux, column), frame.index))
      od
      MalEvalJobSetApply(slot, frame.form, callArgs)
    elseif (frame.kind == 102) ithen
      MalEvalJobSetApply(slot, frame.form, MalMkList2(frame.data, MalAt(frame.aux, frame.index)))
    elseif (frame.kind == 103) ithen
      if (frame.flag == 1) ithen
        ;; drop-while stops calling its predicate after the first false result.
        MalEvalJobReturn(slot, MalMkBool(0))
      else
        MalEvalJobSetApply(slot, frame.form, MalMkList1(MalAt(frame.aux, frame.index)))
      endif
    else
      ;; take/drop copy one item per dispatcher step.
      MalEvalJobReturn(slot, MalAt(frame.aux, frame.index))
    endif
  endif
endop

opcode MalEvalJobBuiltinStart(slot:i, fn:MalValue, args:MalValue):i
  handled:i = 0
  if (fn.type == $MAL_BUILTIN_TYPE) ithen
    name:S init fn.string
    frame:MalEvalFrame init 0, 0, MalMkValue($MAL_NIL_TYPE), MalMkValue($MAL_NIL_TYPE), MalMkValue($MAL_NIL_TYPE), MalMkValue($MAL_NIL_TYPE), 0, 0, 0
    frame.env = malEvalJobs[slot].env
    frame.index = 0
    frame.flag = 0

    if (strcmp(name, "apply") == 0 && lenarray(fn.env) == 0) ithen
      handled = 1
      if (args.length < 2) ithen
        MalEvalJobReturn(slot, MalMkError(sprintf("apply: expected at least 2 arguments, got %d", args.length)))
      elseif (MalIsSequential(MalAt(args, args.length - 1)) == 0) ithen
        MalEvalJobReturn(slot, MalMkError("apply: final argument must be list or vector"))
      else
        MalEvalJobSetApply(slot, MalAt(args, 0), MalFlattenApplyArgs(args))
      endif

    elseif (strcmp(name, "map") == 0 && lenarray(fn.env) == 0) ithen
      handled = 1
      if (args.length != 2) ithen
        MalEvalJobReturn(slot, MalArityError(name, 2, args.length))
      else
        sequence:MalValue init MalAt(args, 1)
        if (MalIsCsoundArray(sequence) == 1) ithen
          sequence init MalCsoundArraySeq(sequence)
        endif
        if (sequence.type == $MAL_ERROR_TYPE) ithen
          MalEvalJobReturn(slot, sequence)
        elseif (MalIsSequential(sequence) == 0) ithen
          MalEvalJobReturn(slot, MalMkError("map: second argument must be list or vector"))
        else
          frame.kind = 100
          frame.form init MalAt(args, 0)
          frame.aux init sequence
          frame.data init MalMkValue($MAL_LIST_TYPE)
          frame.limit = sequence.length
          MalEvalJobBuiltinContinue(slot, frame)
        endif
      endif

    elseif (strcmp(name, "mapv") == 0 && lenarray(fn.env) == 0) ithen
      handled = 1
      if (args.length < 2) ithen
        MalEvalJobReturn(slot, MalMkError("mapv: expected a function and at least one collection"))
      else
        collections:MalValue init MalMkValue($MAL_LIST_TYPE)
        size:i = -1
        failure:MalValue init MalMkValue($MAL_NIL_TYPE)
        for index in [1 ... args.length - 1] do
          sequence:MalValue init MalSeq(MalAt(args, index))
          if (sequence.type == $MAL_ERROR_TYPE) ithen
            failure init sequence
            break
          endif
          collections init MalAppendValue(collections, sequence)
          size = size < 0 ? sequence.length : min(size, sequence.length)
        od
        if (failure.type == $MAL_ERROR_TYPE) ithen
          MalEvalJobReturn(slot, failure)
        else
          frame.kind = 101
          frame.form init MalAt(args, 0)
          frame.aux init collections
          frame.data init MalMkValue($MAL_VECTOR_TYPE)
          frame.limit = size
          MalEvalJobBuiltinContinue(slot, frame)
        endif
      endif

    elseif (strcmp(name, "reduce") == 0 && lenarray(fn.env) == 0) ithen
      handled = 1
      if (args.length != 2 && args.length != 3) ithen
        MalEvalJobReturn(slot, MalMkError("reduce: expected 2 or 3 arguments"))
      else
        sequence:MalValue init MalSeq(MalAt(args, args.length - 1))
        if (sequence.type == $MAL_ERROR_TYPE) ithen
          MalEvalJobReturn(slot, sequence)
        elseif (args.length == 2 && sequence.length == 0) ithen
          ;; Empty reductions return the zero-argument call unchanged.
          MalEvalJobSetApply(slot, MalAt(args, 0), MalMkValue($MAL_LIST_TYPE))
        else
          frame.kind = 102
          frame.form init MalAt(args, 0)
          frame.aux init sequence
          frame.limit = sequence.length
          if (args.length == 3) ithen
            frame.data init MalAt(args, 1)
          else
            frame.data init MalAt(sequence, 0)
            frame.index = 1
          endif
          MalEvalJobBuiltinContinue(slot, frame)
        endif
      endif

    elseif ((strcmp(name, "filter") == 0 || strcmp(name, "filterv") == 0 || \
        strcmp(name, "remove") == 0 || strcmp(name, "keep") == 0 || \
        strcmp(name, "every?") == 0 || strcmp(name, "not-every?") == 0 || \
        strcmp(name, "some") == 0 || strcmp(name, "not-any?") == 0 || \
        strcmp(name, "take-while") == 0 || strcmp(name, "drop-while") == 0) && lenarray(fn.env) == 0) ithen
      handled = 1
      if (args.length != 2) ithen
        MalEvalJobReturn(slot, MalArityError(name, 2, args.length))
      else
        sequence:MalValue init MalSeq(MalAt(args, 1))
        if (sequence.type == $MAL_ERROR_TYPE) ithen
          MalEvalJobReturn(slot, sequence)
        else
          frame.kind = 103
          frame.form init MalAt(args, 0)
          frame.aux init sequence
          frame.extra init MalMkString(name)
          frame.data init MalMkValue(strcmp(name, "filterv") == 0 ? $MAL_VECTOR_TYPE : $MAL_LIST_TYPE)
          frame.limit = sequence.length
          MalEvalJobBuiltinContinue(slot, frame)
        endif
      endif

    elseif (strcmp(name, "swap!") == 0 && lenarray(fn.env) == 0) ithen
      handled = 1
      if (args.length < 2) ithen
        MalEvalJobReturn(slot, MalMkError(sprintf("swap!: expected at least 2 arguments, got %d", args.length)))
      else
        atom:MalValue init MalAt(args, 0)
        if (atom.type != $MAL_ATOM_TYPE) ithen
          MalEvalJobReturn(slot, MalMkError("swap!: first argument must be an atom"))
        else
          frame.kind = 104
          frame.form init MalAt(args, 1)
          frame.data init atom
          frame.aux init MalCoreSlice(args, 2, args.length, 0)
          frame.index = malAtomVersions[atom.number]
          callArgs:MalValue init MalMkList1(MalAtomValue(atom))
          if (frame.aux.length > 0) ithen
            for index in [0 ... frame.aux.length - 1] do
              callArgs init MalAppendValue(callArgs, MalAt(frame.aux, index))
            od
          endif
          MalEvalJobPush(slot, frame)
          MalEvalJobSetApply(slot, frame.form, callArgs)
        endif
      endif

    elseif ((strcmp(name, "update") == 0 || strcmp(name, "update-in") == 0) && lenarray(fn.env) == 0) ithen
      handled = 1
      if (args.length < 3) ithen
        MalEvalJobReturn(slot, MalMkError(sprintf("%s: invalid arguments", name)))
      else
        path:MalValue init MalMkList1(MalAt(args, 1))
        if (strcmp(name, "update-in") == 0) ithen
          path init MalSeq(MalAt(args, 1))
          if (path.length == 0 && path.type != $MAL_ERROR_TYPE) ithen
            path init MalMkList1(MalMkValue($MAL_NIL_TYPE))
          endif
        endif
        if (path.type == $MAL_ERROR_TYPE) ithen
          MalEvalJobReturn(slot, path)
        else
          old:MalValue init MalCoreGetIn(MalAt(args, 0), path, MalMkValue($MAL_NIL_TYPE))
          if (old.type == $MAL_ERROR_TYPE) ithen
            MalEvalJobReturn(slot, old)
          else
            frame.kind = 105
            frame.data init MalAt(args, 0)
            frame.aux init path
            callArgs:MalValue init MalMkList1(old)
            if (args.length > 3) ithen
              for index in [3 ... args.length - 1] do
                callArgs init MalAppendValue(callArgs, MalAt(args, index))
              od
            endif
            MalEvalJobPush(slot, frame)
            MalEvalJobSetApply(slot, MalAt(args, 2), callArgs)
          endif
        endif
      endif

    elseif ((strcmp(name, "take") == 0 || strcmp(name, "drop") == 0) && lenarray(fn.env) == 0) ithen
      handled = 1
      if (args.length != 2) ithen
        MalEvalJobReturn(slot, MalArityError(name, 2, args.length))
      else
        amount:MalValue init MalAt(args, 0)
        sequence:MalValue init MalSeq(MalAt(args, 1))
        if (amount.type != $MAL_NUMBER_TYPE) ithen
          MalEvalJobReturn(slot, MalMkError(sprintf("%s: count must be a number", name)))
        elseif (sequence.type == $MAL_ERROR_TYPE) ithen
          MalEvalJobReturn(slot, sequence)
        else
          size:i = min(sequence.length, max(0, ceil(amount.number)))
          frame.kind = 106
          frame.data init MalMkValue($MAL_LIST_TYPE)
          frame.aux init sequence
          frame.index = strcmp(name, "take") == 0 ? 0 : size
          frame.limit = strcmp(name, "take") == 0 ? size : sequence.length
          MalEvalJobBuiltinContinue(slot, frame)
        endif
      endif

    elseif (strcmp(name, "eval") == 0 && lenarray(fn.env) == 0) ithen
      handled = 1
      if (args.length != 1) ithen
        MalEvalJobReturn(slot, MalArityError(name, 1, args.length))
      else
        root:MalEnv init MalEnvRoot(MalEnvHandle(frame.env))
        frame.kind = 108
        MalEvalJobPush(slot, frame)
        MalEvalJobSetEval(slot, MalAt(args, 0), root.id)
      endif

    elseif (strcmp(name, "load-file") == 0 && lenarray(fn.env) > 0) ithen
      handled = 1
      if (args.length != 1) ithen
        MalEvalJobReturn(slot, MalMkError("load-file: expected one argument"))
      else
        path:MalValue init MalAt(args, 0)
        if (path.type != $MAL_STRING_TYPE) ithen
          MalEvalJobReturn(slot, MalMkError("load-file: expected a filename string"))
        else
          MalEvalJobReturn(slot, MalMkError("load-file: load files before starting cooperative evaluation"))
        endif
      endif

    elseif (strcmp(name, "require") == 0 && lenarray(fn.env) > 0) ithen
      handled = 1
      root:MalEnv init MalEnvRoot(fn.env[0])
      result:MalValue init MalMkValue($MAL_NIL_TYPE)
      if (args.length > 0) ithen
        for index in [0 ... args.length - 1] do
          result init MalRequireSpecValid(MalAt(args, index))
          if (result.type == $MAL_ERROR_TYPE) ithen
            break
          endif
        od
        if (result.type != $MAL_ERROR_TYPE) ithen
          for index in [0 ... args.length - 1] do
            library:MalValue init MalAt(args, index)
            if (library.type == $MAL_VECTOR_TYPE) ithen
              library init MalAt(library, 0)
            endif
            nsIndex:i = MalNsFind(root.id, library.string)
            loaded:i = 0
            if (nsIndex >= 0) ithen
              loaded = malNamespaces[nsIndex].status == 1 ? 1 : 0
            endif
            if (loaded == 0) ithen
              result init MalMkError(sprintf("require: load namespace '%s' before starting cooperative evaluation", library.string))
              break
            endif
          od
        endif
      endif
      if (result.type != $MAL_ERROR_TYPE) ithen
        result init MalNsRequire(root, args)
      endif
      MalEvalJobReturn(slot, result)
    endif
  endif
  xout handled
endop

opcode MalEvalJobBuiltinResume(slot:i, frame:MalEvalFrame, value:MalValue):void
  malEvalJobs[slot].env = frame.env
  if (value.type == $MAL_ERROR_TYPE) ithen
    MalEvalJobReturn(slot, value)
  elseif (frame.kind == 100 || frame.kind == 101 || frame.kind == 106) ithen
    frame.data init MalAppendValue(frame.data, value)
    frame.index += 1
    MalEvalJobBuiltinContinue(slot, frame)
  elseif (frame.kind == 102) ithen
    if (value.type == $MAL_REDUCED_TYPE) ithen
      MalEvalJobReturn(slot, MalAt(value, 0))
    else
      frame.data init value
      frame.index += 1
      MalEvalJobBuiltinContinue(slot, frame)
    endif
  elseif (frame.kind == 103) ithen
    name:S init frame.extra.string
    truth:i = MalIsTruthy(value)
    done:i = 0
    if (strcmp(name, "some") == 0 || strcmp(name, "not-any?") == 0) ithen
      if (truth == 1) ithen
        done = 1
        if (strcmp(name, "some") == 0) ithen
          MalEvalJobReturn(slot, value)
        else
          MalEvalJobReturn(slot, MalMkBool(0))
        endif
      endif
    elseif (strcmp(name, "every?") == 0 || strcmp(name, "not-every?") == 0) ithen
      if (truth == 0) ithen
        done = 1
        MalEvalJobReturn(slot, MalMkBool(strcmp(name, "not-every?") == 0 ? 1 : 0))
      endif
    elseif (strcmp(name, "take-while") == 0 && truth == 0) ithen
      done = 1
      MalEvalJobReturn(slot, frame.data)
    else
      include:i = truth
      if (strcmp(name, "keep") == 0) ithen
        include = value.type != $MAL_NIL_TYPE ? 1 : 0
      elseif (strcmp(name, "remove") == 0) ithen
        include = 1 - truth
      elseif (strcmp(name, "drop-while") == 0) ithen
        if (truth == 0) ithen
          frame.flag = 1
        endif
        include = frame.flag
      endif
      if (include == 1) ithen
        if (strcmp(name, "keep") == 0) ithen
          frame.data init MalAppendValue(frame.data, value)
        else
          frame.data init MalAppendValue(frame.data, MalAt(frame.aux, frame.index))
        endif
      endif
    endif
    if (done == 0) ithen
      frame.index += 1
      MalEvalJobBuiltinContinue(slot, frame)
    endif
  elseif (frame.kind == 104) ithen
    atom:MalValue init frame.data
    if (frame.index != malAtomVersions[atom.number]) ithen
      ;; A callback changed the atom while this job yielded. Retry with its
      ;; latest value, including when another writer restored the old value.
      frame.index = malAtomVersions[atom.number]
      callArgs:MalValue init MalMkList1(MalAtomValue(atom))
      if (frame.aux.length > 0) ithen
        for index in [0 ... frame.aux.length - 1] do
          callArgs init MalAppendValue(callArgs, MalAt(frame.aux, index))
        od
      endif
      MalEvalJobPush(slot, frame)
      MalEvalJobSetApply(slot, frame.form, callArgs)
    else
      MalEvalJobReturn(slot, MalAtomSetValue(atom, value))
    endif
  elseif (frame.kind == 105) ithen
    MalEvalJobReturn(slot, MalCoreAssocIn(frame.data, frame.aux, 0, value))
  elseif (frame.kind == 108) ithen
    MalEvalJobReturn(slot, value)
  else
    MalEvalJobReturn(slot, MalMkError("unknown builtin continuation"))
  endif
endop
;; End src/eval-job-builtins.orc


opcode MalEvalJobEval(slot:i):void
  ast:MalValue init malEvalJobAsts[slot]
  env:MalEnv init MalEnvHandle(malEvalJobs[slot].env)
  if (malDebugEvalBindingSeen == 1) ithen
    debug:MalValue init MalResolveSymbol(env, "DEBUG-EVAL")
    if (debug.type != $MAL_ERROR_TYPE && MalIsTruthy(debug) == 1) ithen
      prints "EVAL: %s\n", pr_str(ast)
    endif
  endif
  frame:MalEvalFrame init 0, env.id, ast, MalMkValue($MAL_NIL_TYPE), MalMkValue($MAL_NIL_TYPE), MalMkValue($MAL_NIL_TYPE), 0, 0, 0
  if (ast.type == $MAL_SYMBOL_TYPE) ithen
    MalEvalJobReturn(slot, MalResolveSymbol(env, ast.string))
  elseif (ast.type == $MAL_VECTOR_TYPE || ast.type == $MAL_HASH_MAP_TYPE) ithen
    if (ast.length == 0) ithen
      MalEvalJobReturn(slot, MalMkValue(ast.type))
    else
      frame.kind = 1
      frame.data init MalMkValue(ast.type)
      frame.index = ast.type == $MAL_HASH_MAP_TYPE ? 1 : 0
      MalEvalJobPush(slot, frame)
      MalEvalJobSetEval(slot, MalAt(ast, frame.index), env.id)
    endif
  elseif (ast.type != $MAL_LIST_TYPE) ithen
    MalEvalJobReturn(slot, ast)
  elseif (ast.length == 0) ithen
    MalEvalJobReturn(slot, MalMkValue($MAL_LIST_TYPE))
  else
    head:MalValue init MalAt(ast, 0)
    if (MalIsSymbolNamed(head, "ns") == 1) ithen
      MalEvalJobReturn(slot, MalEvalJobNamespace(ast, env))
    elseif (MalIsSymbolNamed(head, "quote") == 1) ithen
      MalEvalJobReturn(slot, MalEvalQuote(ast))
    elseif (MalIsSymbolNamed(head, "quasiquote") == 1) ithen
      if (ast.length != 2) ithen
        MalEvalJobReturn(slot, MalArityError("quasiquote", 1, ast.length - 1))
      else
        quoted:MalValue init MalQuasiquote(MalAt(ast, 1))
        if (quoted.type == $MAL_ERROR_TYPE) ithen
          MalEvalJobReturn(slot, quoted)
        else
          MalEvalJobSetEval(slot, quoted, env.id)
        endif
      endif
    elseif (MalIsSymbolNamed(head, "def") == 1 || MalIsSymbolNamed(head, "def!") == 1 || MalIsSymbolNamed(head, "defmacro!") == 1) ithen
      MalEvalJobDefine(slot, ast, MalIsSymbolNamed(head, "defmacro!"), MalIsSymbolNamed(head, "def"))
    elseif (MalIsSymbolNamed(head, "defn") == 1 || MalIsSymbolNamed(head, "defmacro") == 1) ithen
      if (ast.length < 3) ithen
        MalEvalJobFail(slot, sprintf("%s: expected a name, parameter vector, and body", head.string))
      else
        name:MalValue init MalAt(ast, 1)
        if (name.type != $MAL_SYMBOL_TYPE) ithen
          MalEvalJobFail(slot, sprintf("%s: first argument must be a symbol", head.string))
        else
          expanded:MalValue init MalExpandFn(ast, 2, head.string)
          if (expanded.type == $MAL_ERROR_TYPE) ithen
            MalEvalJobReturn(slot, expanded)
          else
            MalEvalJobDefine(slot, MalMkList3(head, name, expanded), MalIsSymbolNamed(head, "defmacro"), 1)
          endif
        endif
      endif
    elseif (MalIsSymbolNamed(head, "fn") == 1) ithen
      expanded:MalValue init MalExpandFn(ast, 1, "fn")
      if (expanded.type == $MAL_ERROR_TYPE) ithen
        MalEvalJobReturn(slot, expanded)
      else
        MalEvalJobSetEval(slot, expanded, env.id)
      endif
    elseif (MalIsSymbolNamed(head, "fn*") == 1) ithen
      value:MalValue, unused:MalEnv = MalEvalFn(ast, env)
      MalEvalJobReturn(slot, value)
    elseif (MalIsSymbolNamed(head, "if") == 1) ithen
      if (ast.length < 3 || ast.length > 4) ithen
        MalEvalJobFail(slot, sprintf("if: expected 2 or 3 arguments, got %d", ast.length - 1))
      else
        frame.kind = 2
        MalEvalJobPush(slot, frame)
        MalEvalJobSetEval(slot, MalAt(ast, 1), env.id)
      endif
    elseif (MalIsSymbolNamed(head, "do") == 1) ithen
      if (ast.length == 1) ithen
        MalEvalJobReturn(slot, MalMkValue($MAL_NIL_TYPE))
      else
        if (ast.length > 2) ithen
          frame.kind = 3
          frame.index = 2
          MalEvalJobPush(slot, frame)
        endif
        MalEvalJobSetEval(slot, MalAt(ast, 1), env.id)
      endif
    elseif (MalIsSymbolNamed(head, "let*") == 1 || MalIsSymbolNamed(head, "let") == 1) ithen
      immutable:i = MalIsSymbolNamed(head, "let")
      body:MalValue init MalMkValue($MAL_NIL_TYPE)
      if (immutable == 1) ithen
        body init MalLetBody(ast)
      elseif (ast.length != 3) ithen
        body init MalArityError("let*", 2, ast.length - 1)
      else
        body init MalAt(ast, 2)
      endif
      if (body.type == $MAL_ERROR_TYPE) ithen
        MalEvalJobReturn(slot, body)
      else
        bindings:MalValue init MalAt(ast, 1)
        if (MalIsSequential(bindings) == 0) ithen
          MalEvalJobFail(slot, "let*: bindings must be list or vector")
        elseif (bindings.length % 2 != 0) ithen
          MalEvalJobFail(slot, "let*: bindings must contain even number of forms")
        else
          letEnv:MalEnv init MalMkEnvWithOuter(env)
          MalEvalJobOwnEnv(slot, letEnv.id)
          frame.kind = 4
          frame.env = letEnv.id
          frame.form init body
          frame.data init bindings
          frame.flag = immutable
          MalEvalJobLetNext(slot, frame)
        endif
      endif
    elseif (MalIsSymbolNamed(head, "try*") == 1) ithen
      if (ast.length < 2 || ast.length > 3) ithen
        MalEvalJobFail(slot, sprintf("try*: expected 1 or 2 arguments, got %d", ast.length - 1))
      elseif (ast.length == 2) ithen
        MalEvalJobSetEval(slot, MalAt(ast, 1), env.id)
      else
        catcher:MalValue init MalAt(ast, 2)
        if (MalIsForm(catcher, "catch*") == 0 || catcher.length != 3) ithen
          MalEvalJobFail(slot, "try*: second argument must be (catch* symbol handler)")
        else
          binding:MalValue init MalAt(catcher, 1)
          if (binding.type != $MAL_SYMBOL_TYPE) ithen
            MalEvalJobFail(slot, "catch*: binding must be a symbol")
          else
            frame.kind = 7
            frame.form init catcher
            MalEvalJobPush(slot, frame)
            MalEvalJobSetEval(slot, MalAt(ast, 1), env.id)
          endif
        endif
      endif
    else
      frame.kind = 5
      MalEvalJobPush(slot, frame)
      MalEvalJobSetEval(slot, head, env.id)
    endif
  endif
endop

opcode MalEvalJobResume(slot:i):void
  value:MalValue init malEvalJobValues[slot]
  depth:i = malEvalJobs[slot].depth
  if (depth == 0) ithen
    malEvalJobs[slot].status = 1
  else
    frame:MalEvalFrame init MalEvalJobPop(slot)
    malEvalJobs[slot].env = frame.env
    if (frame.kind == 9) ithen
      MalEnvRelease(MalEnvHandle(frame.env))
    elseif (value.type == $MAL_ERROR_TYPE) ithen
      if (frame.kind == 7) ithen
        catchEnv:MalEnv init MalMkEnvWithOuter(MalEnvHandle(frame.env))
        MalEvalJobOwnEnv(slot, catchEnv.id)
        binding:MalValue init MalAt(frame.form, 1)
        catchEnv init MalEnvSet(catchEnv, binding.string, MalErrorPayload(value))
        MalEvalJobSetEval(slot, MalAt(frame.form, 2), catchEnv.id)
      endif
    elseif (frame.kind >= 100) ithen
      MalEvalJobBuiltinResume(slot, frame, value)
    elseif (frame.kind == 1) ithen
      ;; Vectors, map values, and call arguments retain left-to-right order.
      if (frame.data.type == $MAL_HASH_MAP_TYPE) ithen
        frame.data init MalMapAssoc(frame.data, MalAt(frame.form, frame.index - 1), value)
        frame.index += 2
      else
        frame.data init MalAppendValue(frame.data, value)
        frame.index += 1
      endif
      if (frame.index < frame.form.length) ithen
        MalEvalJobPush(slot, frame)
        MalEvalJobSetEval(slot, MalAt(frame.form, frame.index), frame.env)
      elseif (frame.flag == 1) ithen
        MalEvalJobSetApply(slot, frame.aux, frame.data)
      else
        MalEvalJobReturn(slot, frame.data)
      endif
    elseif (frame.kind == 2) ithen
      if (MalIsTruthy(value) == 1) ithen
        MalEvalJobSetEval(slot, MalAt(frame.form, 2), frame.env)
      elseif (frame.form.length == 4) ithen
        MalEvalJobSetEval(slot, MalAt(frame.form, 3), frame.env)
      else
        MalEvalJobReturn(slot, MalMkValue($MAL_NIL_TYPE))
      endif
    elseif (frame.kind == 3) ithen
      next:MalValue init MalAt(frame.form, frame.index)
      frame.index += 1
      if (frame.index < frame.form.length) ithen
        MalEvalJobPush(slot, frame)
      endif
      MalEvalJobSetEval(slot, next, frame.env)
    elseif (frame.kind == 4) ithen
      letEnv:MalEnv init MalEnvHandle(frame.env)
      if (frame.flag == 1) ithen
        letEnv init MalMkEnvWithOuter(letEnv)
        MalEvalJobOwnEnv(slot, letEnv.id)
      endif
      name:MalValue init MalAt(frame.data, frame.index)
      letEnv init MalEnvSet(letEnv, name.string, value)
      frame.env = letEnv.id
      frame.index += 2
      MalEvalJobLetNext(slot, frame)
    elseif (frame.kind == 5) ithen
      if (MalIsMacro(value) == 1) ithen
        frame.kind = 8
        MalEvalJobPush(slot, frame)
        MalEvalJobSetApply(slot, value, MalUnevaluatedArgs(frame.form))
      elseif (frame.form.length == 1) ithen
        MalEvalJobSetApply(slot, value, MalMkValue($MAL_LIST_TYPE))
      else
        frame.kind = 1
        frame.aux init value
        frame.data init MalMkValue($MAL_LIST_TYPE)
        frame.index = 1
        frame.flag = 1
        MalEvalJobPush(slot, frame)
        MalEvalJobSetEval(slot, MalAt(frame.form, 1), frame.env)
      endif
    elseif (frame.kind == 6) ithen
      if (frame.flag == 1 && value.type != $MAL_FUNCTION_TYPE) ithen
        MalEvalJobFail(slot, sprintf("%s: value must be a function", frame.aux.string))
      else
        if (frame.flag == 1) ithen
          value init MalFunctionAsMacro(value)
        endif
        target:MalEnv init MalEnvSet(MalEnvHandle(frame.index), frame.data.string, value)
        if (MalIsFnForm(frame.form) == 1) ithen
          value init MalFunctionCaptureEnv(value, MalEnvHandle(frame.env))
          target init MalEnvSet(target, frame.data.string, value)
        endif
        MalEvalJobReturn(slot, value)
      endif
    elseif (frame.kind == 8) ithen
      MalEvalJobSetEval(slot, value, frame.env)
    endif
  endif
endop

opcode MalEvalJobApply(slot:i):void
  fn:MalValue init malEvalJobFunctions[slot]
  args:MalValue init malEvalJobArguments[slot]
  if (fn.type == $MAL_FUNCTION_TYPE) ithen
    result:MalValue, callEnv:MalEnv = MalBindFunctionEnv(fn, args)
    if (result.type == $MAL_ERROR_TYPE) ithen
      MalEvalJobReturn(slot, result)
    else
      ;; Bind first: a returned closure may retain the preceding scope. Then
      ;; discard only tail-position cleanup frames before entering the body.
      MalEvalJobSetEval(slot, MalFunctionBody(fn), callEnv.id)
      malEvalJobs[slot].mode = 4
    endif
  elseif (MalEvalJobBuiltinStart(slot, fn, args) == 0) ithen
    MalEvalJobReturn(slot, MalApply(fn, args))
  endif
endop

;; Start returns a positive, never-reused token, or -1 when all slots are held.
;; Completed jobs keep their result until Cancel releases the token.
opcode MalEvalJobStart(ast:MalValue, env:MalEnv):i
  slot:i = -1
  for index in [0 ... lenarray(malEvalJobs) - 1] do
    if (malEvalJobs[index].id == 0) ithen
      slot = index
      break
    endif
  od
  id:i = -1
  if (slot >= 0) ithen
    id = malEvalJobNextId
    malEvalJobNextId += 1
    malEvalJobs[slot].id = id
    malEvalJobs[slot].status = 0
    malEvalJobs[slot].depth = 0
    malEvalJobs[slot].top = -1
    malEvalJobValues[slot] init MalMkValue($MAL_NIL_TYPE)
    MalEvalJobSetEval(slot, ast, env.id)
  endif
  xout id
endop

;; 0 means pending, 1 means complete (including a Lisp error), -1 means an
;; unknown token. A nonpositive budget observes status without running work.
opcode MalEvalJobStep(id:i, budget:i):i
  slot:i = MalEvalJobSlot(id)
  status:i = -1
  if (slot >= 0) ithen
    remaining:i = max(0, int(budget))
    while (remaining > 0 && malEvalJobs[slot].status == 0) do
      mode:i = malEvalJobs[slot].mode
      if (mode == 0) ithen
        MalEvalJobEval(slot)
      elseif (mode == 1) ithen
        MalEvalJobResume(slot)
      elseif (mode == 2) ithen
        MalEvalJobApply(slot)
      elseif (mode == 4) ithen
        tailScope:i = 0
        if (malEvalJobs[slot].depth > 0) ithen
          top:i = malEvalJobs[slot].top
          tailScope = malEvalJobFrames[top].kind == 9
        endif
        if (tailScope == 1) ithen
          frame:MalEvalFrame init MalEvalJobPop(slot)
          MalEnvRelease(MalEnvHandle(frame.env))
        else
          MalEvalJobOwnEnv(slot, malEvalJobs[slot].env)
          malEvalJobs[slot].mode = 0
        endif
      endif
      remaining -= 1
    od
    status = malEvalJobs[slot].status
  endif
  xout status
endop

opcode MalEvalJobResult(id:i):MalValue
  slot:i = MalEvalJobSlot(id)
  result:MalValue init MalMkError("evaluation job: unknown token")
  if (slot >= 0) ithen
    if (malEvalJobs[slot].status == 1) ithen
      result init malEvalJobValues[slot]
    else
      result init MalMkError("evaluation job: still pending")
    endif
  endif
  xout result
endop

opcode MalEvalJobCancel(id:i):void
  slot:i = MalEvalJobSlot(id)
  if (slot >= 0) ithen
    ;; A newly bound tail call has not yet installed its cleanup frame.
    if (malEvalJobs[slot].mode == 4) ithen
      MalEnvRelease(MalEnvHandle(malEvalJobs[slot].env))
    endif
    while (malEvalJobs[slot].depth > 0) do
      frame:MalEvalFrame init MalEvalJobPop(slot)
      if (frame.kind == 9) ithen
        MalEnvRelease(MalEnvHandle(frame.env))
      endif
    od
    malEvalJobs[slot].id = 0
    malEvalJobs[slot].status = -1
    malEvalJobs[slot].top = -1
    malEvalJobAsts[slot] init MalMkValue($MAL_NIL_TYPE)
    malEvalJobValues[slot] init MalMkValue($MAL_NIL_TYPE)
    malEvalJobFunctions[slot] init MalMkValue($MAL_NIL_TYPE)
    malEvalJobArguments[slot] init MalMkValue($MAL_NIL_TYPE)
  endif
endop
;; End src/eval-job.orc
;; End src/main.orc

#endif
