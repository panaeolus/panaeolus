;; Select each call separately. Held edits keep the same voice alive.
(require '[panaeolus.instruments.drone :as drone])
(require '[panaeolus.instrument :as p])
(require '[panaeolus.fx :as fx])

(drone/horizon)
(drone/horizon :legato true :note 36 :attack 2 :db -12)
(drone/horizon :legato true :note 43 :color 0.8 :drift 12 :db -12)
(p/stop! drone/horizon)

(drone/undertow :legato true :note 36 :ratio 1.5 :index 3 :db -12
  :fx (fx/flanger :rate 0.05 :depth 0.002 :fback 0.3))
(drone/undertow :legato true :note 36 :ratio 2.03 :index 5 :rate 0.04 :db -12
  :fx (fx/flanger :rate 0.05 :depth 0.002 :fback 0.3))
(p/stop! drone/undertow)

(drone/aether :legato true :note 48 :air 0.8 :stretch 1.2 :attack 2 :db -12)
(drone/aether :legato true :note 55 :air 0.4 :focus 0.9 :bandwidth 0.04 :db -12)
(p/stop! drone/aether)

;; Each event edits the held model instead of starting a new attack.
(drone/horizon :every [4 6] :legato true :note [36 43 48]
  :cutoff [1200 2400 4000] :db -12)
(p/stop! drone/horizon)

;; A silent plan for longer compositions.
(def phrase (p/pattern drone/undertow :every [4]
  :note [36 43 48] :ratio [1.5 2.03] :dur 3.8 :attack 0.5 :db -12))
