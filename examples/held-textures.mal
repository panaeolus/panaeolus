;; Select each call separately. Held edits keep the same voice alive.
(require '[panaeolus.instruments.subtractive :as subtractive])
(require '[panaeolus.instruments.fm :as fm])
(require '[panaeolus.instruments.resonant :as resonant])
(require '[panaeolus.instrument :as p])
(require '[panaeolus.fx :as fx])

(subtractive/horizon)
(subtractive/horizon :legato true :note 36 :attack 2 :db -12)
(subtractive/horizon :legato true :note 43 :color 0.8 :drift 12 :db -12)
(p/stop! subtractive/horizon)

(fm/undertow :legato true :note 36 :ratio 1.5 :index 3 :db -12
  :fx (fx/flanger :rate 0.05 :depth 0.002 :fback 0.3))
(fm/undertow :legato true :note 36 :ratio 2.03 :index 5 :rate 0.04 :db -12
  :fx (fx/flanger :rate 0.05 :depth 0.002 :fback 0.3))
(p/stop! fm/undertow)

(resonant/aether :legato true :note 48 :air 0.8 :stretch 1.2 :attack 2 :db -12)
(resonant/aether :legato true :note 55 :air 0.4 :focus 0.9 :bandwidth 0.04 :db -12)
(p/stop! resonant/aether)

;; Each event edits the held model instead of starting a new attack.
(subtractive/horizon :every [4 6] :legato true :note [36 43 48]
  :cutoff [1200 2400 4000] :db -12)
(p/stop! subtractive/horizon)

;; A silent plan for longer compositions.
(def phrase (p/pattern fm/undertow :every [4]
  :note [36 43 48] :ratio [1.5 2.03] :dur 3.8 :attack 0.5 :db -12))
