;; Evaluate the setup, then individual calls. p/stop-all! stops the arrangement.
(ns catalogue
  (:require [panaeolus.instrument :as p]
            [panaeolus.instruments.drums :as drums]
            [panaeolus.instruments.synth :as synth]
            [panaeolus.instruments.brass :as brass]
            [panaeolus.sampler :as sampler]
            [panaeolus.fx :as fx]))
(p/tempo! 120)
(drums/kick :every [1])
(drums/clap-808 :every [2] :offset 1 :db -9)
(drums/maraca :every [0.5] :offset 0.25 :db [-14 -18])
(synth/tb303 :every [0.25 0.25 0.5] :note [36 36 43 48 46]
  :dur 0.13 :cutoff [350 700 1400] :accent [0 0.8] :db -9)

;; More drums, all with controllable pitch and decay:
;; (drums/high-conga :every [0.5 0.25 0.75] :slap [0.1 0.3])
;; (drums/mid-conga)
;; (drums/low-conga)

