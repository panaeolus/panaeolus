  reese-node 1 {:note [24 96] :detune [0 60] :color [0 1] :notch [100 6000] :depth [0 1] :motion [0 1] :rate [0.05 8] :drive [1 5] :cutoff [150 14000] :sub [0 1] :width [0 1] :attack [0.001 8] :decay [0.001 8] :sustain [0 1] :release [0.001 4] :glide [0 2]} true))
(ns user)
