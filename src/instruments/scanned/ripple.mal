(ns panaeolus.instruments.scanned (:require [panaeolus.catalog :as catalog]))
(def ripple (catalog/voice "panaeolus.instruments.scanned/ripple"
  '[note 60 db -6 speed 2.2 mass 1 damping 0.7 shape 0.8 drive 0.5 warp 0.3 spread 0.65 cutoff 9000 attack 0.02 decay 0.15 sustain 0.8 release 0.3 glide 0.03 pan 0 amp 1]
  ripple-node 1 {:note [24 96] :speed [0.1 4] :mass [0.5 4] :damping [0.1 8] :shape [0 1] :drive [0 1] :warp [0 0.8] :spread [0 1] :cutoff [200 18000] :attack [0.001 8] :decay [0.001 8] :sustain [0 1] :release [0.001 4] :glide [0 2]} true))
(ns user)
