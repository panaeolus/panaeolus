(ns panaeolus.instruments.dubstep (:require [panaeolus.catalog :as catalog]))
(def wub (catalog/voice "panaeolus.instruments.dubstep/wub"
  '[note 36 db -6 cutoff 180 sweep 4 resonance 0.35 drive 2 pulse 0.4 bpm 140 division 0.5 phase 0 sharpness 1.3 gate 0.35 detune 8 sub 0.55 attack 0.01 decay 0.5 sustain 0.85 release 0.15 glide 0.15 pan 0 amp 1]
  wub-node 1 {:note [24 96] :cutoff [60 8000] :sweep [0 6] :resonance [0 0.85] :drive [1 5] :pulse [0.05 0.95] :bpm [20 400] :division [0.125 8] :phase [0 1] :sharpness [0.25 4] :gate [0 1] :detune [0 25] :sub [0 1] :attack [0.001 8] :decay [0.001 8] :sustain [0 1] :release [0.001 4] :glide [0 2]} true))
(ns user)
