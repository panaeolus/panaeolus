(ns panaeolus.instruments.synth (:require [panaeolus.catalog :as catalog]))
(def pmdub (catalog/voice "panaeolus.instruments.synth/pmdub"
  '[note 36 db -6 ratio 1.5 index 3 spread 0.2 motion 2 depth 0.6 sub 0.3 drive 1.5 attack 0.01 decay 0.2 sustain 0.75 release 0.15 glide 0.02 pan 0 amp 1]
  pmdub-node 1 {:note [24 96] :ratio [0.25 8] :index [0 8] :spread [0 2] :motion [0 20] :depth [0 1] :sub [0 1] :drive [1 8] :attack [0.001 8] :decay [0.001 8] :sustain [0 1] :release [0.001 4] :glide [0 2]} true))
(ns user)
