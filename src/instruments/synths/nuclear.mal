(ns panaeolus.instruments.synth (:require [panaeolus.catalog :as catalog]))
(def nuclear (catalog/voice "panaeolus.instruments.synth/nuclear"
  '[note 48 db -6 detune 12 cutoff 2400 resonance 0.25 sub 0.25 width 0.8 drive 1.5 attack 0.01 decay 0.2 sustain 0.75 release 0.15 glide 0.02 pan 0 amp 1]
  nuclear-node 1 {:note [24 96] :detune [0 45] :cutoff [40 18000] :resonance [0 0.8] :sub [0 1] :width [0 1] :drive [1 8] :attack [0.001 8] :decay [0.001 8] :sustain [0 1] :release [0.001 4] :glide [0 2]} true))
(ns user)
