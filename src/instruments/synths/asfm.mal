(ns panaeolus.instruments.synth (:require [panaeolus.catalog :as catalog]))
(def asfm (catalog/voice "panaeolus.instruments.synth/asfm"
  '[note 60 db -6 ratio 1.5 index 2.5 asymmetry 0.4 cutoff 8000 attack 0.01 decay 0.2 sustain 0.75 release 0.15 glide 0.02 pan 0 amp 1]
  asfm-node 1 {:note [24 96] :ratio [0.25 8] :index [0 8] :asymmetry [0 1] :cutoff [40 18000] :attack [0.001 8] :decay [0.001 8] :sustain [0 1] :release [0.001 4] :glide [0 2]} true))
(ns user)
