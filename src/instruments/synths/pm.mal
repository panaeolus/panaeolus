(ns panaeolus.instruments.synth (:require [panaeolus.catalog :as catalog]))
(def pm (catalog/voice "panaeolus.instruments.synth/pm"
  '[note 60 db -6 ratio1 1 ratio2 2 ratio3 3 index1 1 index2 1.5 index3 2 brightness 0.5 attack 0.01 decay 0.2 sustain 0.75 release 0.15 glide 0.02 pan 0 amp 1]
  pm-node 1 {:note [24 96] :ratio1 [0.25 8] :ratio2 [0.25 8] :ratio3 [0.25 8] :index1 [0 6] :index2 [0 6] :index3 [0 6] :brightness [0 1] :attack [0.001 8] :decay [0.001 8] :sustain [0 1] :release [0.001 4] :glide [0 2]} true))
(ns user)
