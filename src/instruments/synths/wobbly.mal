(ns panaeolus.instruments.synth (:require [panaeolus.catalog :as catalog]))
(def wobbly (catalog/voice "panaeolus.instruments.synth/wobbly"
  '[note 36 db -6 bpm 120 division 0.5 depth 3 shape 0.5 cutoff 250 resonance 0.5 sub 0.4 drive 2 attack 0.01 decay 0.2 sustain 0.75 release 0.15 glide 0.02 pan 0 amp 1]
  wobbly-node 1 {:note [24 96] :bpm [20 400] :division [0.125 16] :depth [0 6] :shape [0 1] :cutoff [40 12000] :resonance [0 0.8] :sub [0 1] :drive [1 10] :attack [0.001 8] :decay [0.001 8] :sustain [0 1] :release [0.001 4] :glide [0 2]} true))
(ns user)
