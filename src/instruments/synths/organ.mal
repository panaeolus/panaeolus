(ns panaeolus.instruments.synth (:require [panaeolus.catalog :as catalog]))
(def organ (catalog/voice "panaeolus.instruments.synth/organ"
  '[note 60 db -6 sub 0.3 fundamental 1 fifth 0.2 octave 0.5 third 0.15 upper 0.1 percussion 0.15 rotary 0.25 rotary-rate 4 attack 0.01 decay 0.2 sustain 0.75 release 0.15 glide 0.02 pan 0 amp 1]
  organ-node 1 {:note [24 96] :sub [0 1] :fundamental [0 1] :fifth [0 1] :octave [0 1] :third [0 1] :upper [0 1] :percussion [0 1] :rotary [0 1] :rotary-rate [0.1 12] :attack [0.001 8] :decay [0.001 8] :sustain [0 1] :release [0.001 4] :glide [0 2]} true))
(ns user)
