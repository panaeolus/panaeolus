(ns panaeolus.instruments.additive (:require [panaeolus.catalog :as catalog]))
(def harmonic (catalog/voice "panaeolus.instruments.additive/harmonic"
  '[note 60 db -6 tilt 1.2 odd 0.25 detune 5 width 0.7 attack 0.01 decay 0.2 sustain 0.75 release 0.15 glide 0.02 pan 0 amp 1]
  harmonic-node 1 {:note [24 96] :tilt [0.25 3] :odd [0 1] :detune [0 30] :width [0 1] :attack [0.001 8] :decay [0.001 8] :sustain [0 1] :release [0.001 4] :glide [0 2]} true))
(ns user)
