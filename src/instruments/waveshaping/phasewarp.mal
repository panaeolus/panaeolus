(ns panaeolus.instruments.waveshaping (:require [panaeolus.catalog :as catalog]))
(def phasewarp (catalog/voice "panaeolus.instruments.waveshaping/phasewarp"
  '[note 60 db -6 bend -0.5 skew 0.2 sub 0.15 motion 0.25 rate 0.3 width 8 cutoff 10000 attack 0.01 decay 0.15 sustain 0.8 release 0.2 glide 0.03 pan 0 amp 1]
  phasewarp-node 1 {:note [24 96] :bend [-0.8 0.8] :skew [-0.6 0.6] :sub [0 1] :motion [0 1] :rate [0.05 12] :width [0 30] :cutoff [200 18000] :attack [0.001 8] :decay [0.001 8] :sustain [0 1] :release [0.001 4] :glide [0 2]} true))
(ns user)
