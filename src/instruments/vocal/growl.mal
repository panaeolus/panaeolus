(ns panaeolus.instruments.vocal (:require [panaeolus.catalog :as catalog]))
(def growl (catalog/voice "panaeolus.instruments.vocal/growl"
  '[note 36 db -6 vowel 0 index 4 ratio 3 bpm 140 division 0.5 phase 0 depth 2 sharpness 1 shift -3 detune 6 sub 0.5 cutoff 9000 attack 0.01 decay 0.5 sustain 0.85 release 0.15 glide 0.15 pan 0 amp 1]
  growl-node 1 {:note [24 96] :vowel [0 4] :index [0 8] :ratio [0.5 6] :bpm [20 400] :division [0.125 8] :phase [0 1] :depth [0 4] :sharpness [0.25 4] :shift [-12 12] :detune [0 30] :sub [0 1] :cutoff [200 14000] :attack [0.001 8] :decay [0.001 8] :sustain [0 1] :release [0.001 4] :glide [0 2]} true))
(ns user)
