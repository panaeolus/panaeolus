(ns panaeolus.instruments.pluck
  (:require [panaeolus.instrument :as p]
            [panaeolus.fx :as fx]
            [panaeolus.level :as level]))

(defn validate [values]
  (level/validate values)
  (when-not (and (fx/in-range? (get values :note) 24 96)
                (fx/in-range? (get values :decay) 0.02 8))
    (throw "pluck: note 24..96 (MIDI), decay 0.02..8 seconds")))

(defn validate-string [values]
  (validate values)
  (when-not (and (fx/in-range? (get values :tone) 0 1)
                (fx/in-range? (get values :position) 0.05 0.95))
    (throw "pluck: tone 0..1, position 0.05..0.95")))

(defn validate-fm [values]
  (validate values)
  (when-not (and (fx/in-range? (get values :ratio) 0.25 8)
                (fx/in-range? (get values :index) 0 8))
    (throw "fmpluck: ratio 0.25..8, index 0..8")))

(p/definst pluck [note 60 db -6 decay 0.8 tone 0.5 position 0.23 pan 0 amp 1]
  (string-node note db decay tone position pan amp))
(def pluck (p/with-validator (p/with-defaults pluck :dur 1) validate-string))

(p/definst fmpluck [note 60 db -6 decay 0.8 ratio 1.5 index 2.5 pan 0 amp 1]
  (fm-node note db decay ratio index pan amp))
(def fmpluck (p/with-validator (p/with-defaults fmpluck :dur 1) validate-fm))
(ns user)
