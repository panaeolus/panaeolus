(ns panaeolus.instrument
  (:require [panaeolus.event-loop :as loop]
            [panaeolus.routing :as routing]
            [panaeolus.fx :as fx]))

;; These helpers do not create closures while a pattern is ticking.
(defn finite-number? [value]
  (and (number? value) (= (- value value) 0)))

(defn positive-number? [value]
  (and (finite-number? value) (> value 0)))

(defn parameter-schema [params keys defaults]
  (if (empty? params)
    {:params keys :defaults defaults}
    (let [parameter (first params)
          value (second params)
          key (keyword (name parameter))]
      (when (or (contains? defaults key)
                (contains? {:dur true :every true :id true :offset true :fx true :legato true} key))
        (throw (str "definst: duplicate or reserved parameter " key)))
      (when-not (finite-number? value)
        (throw (str "definst: default for " key " must be a finite number")))
      (parameter-schema (drop 2 params) (conj keys key) (assoc defaults key value)))))

(defn output [signal]
  (cond
    (vector? signal)
      (if (and (= 2 (count signal))
               (= :a (csound/type (first signal)))
               (= :a (csound/type (second signal))))
        (csound/outs (first signal) (second signal))
        (throw "definst: a stereo vector must contain two audio signals"))
    (= :a (csound/type signal)) (csound/outs signal signal)
    (= [:a :a] (csound/type signal)) (csound/outs signal)
    :else (throw "definst: return mono audio or a stereo pair; Panaeolus adds the output")))

(defn resolve-descriptor [reference]
  (let [spec @reference]
    (if (get spec :factory)
      (let [resolved (instrument-spec ((get spec :factory)))]
        (when-not (= (get spec :id) (get resolved :id))
          (throw "defer: factory changed instrument identity"))
        (reset! reference resolved))
      spec)))

(defn instrument-spec [instrument]
  (let [reference (get (get (meta instrument) :panaeolus/instrument) :descriptor)]
    (if (and (fn? instrument) (atom? reference)) (resolve-descriptor reference)
      (throw "expected a Panaeolus instrument"))))

(defn descriptor [instrument]
  (let [spec (instrument-spec instrument)]
    (assoc spec :signal @(get spec :signal))))

(defn put-argument [supplied key value]
  (if (contains? supplied key)
    (throw (str "instrument: duplicate argument " key))
    (assoc supplied key value)))

(defn read-arguments [spec args position named supplied]
  (if (empty? args)
    supplied
    (let [head (first args)]
      (if (keyword? head)
        (do
          (when (< (count args) 2)
            (throw (str "instrument: missing value for " head)))
          (when-not (or (contains? (get spec :defaults) head)
                        (contains? {:dur true :every true :id true :offset true :fx true :legato true} head))
            (throw (str "instrument: unknown argument " head)))
          (read-arguments spec (drop 2 args) position true
            (put-argument supplied head (second args))))
        (do
          (when named
            (throw "instrument: positional arguments must come before named arguments"))
          (when (>= position (count (get spec :params)))
            (throw "instrument: too many positional arguments"))
          (read-arguments spec (rest args) (inc position) false
            (put-argument supplied (nth (get spec :params) position) head)))))))

(defn valid-value? [value pattern positive]
  (if (and pattern (vector? value))
    (and (not (empty? value))
         (every? (if positive positive-number? finite-number?) value))
    ((if positive positive-number? finite-number?) value)))

(defn validate-values [keys arguments pattern]
  (when-not (empty? keys)
    (let [key (first keys)]
      (when-not (valid-value? (get arguments key) pattern false)
        (throw (str "instrument: " key " needs a finite number"
                    (if pattern " or a nonempty vector of finite numbers" ""))))
      (validate-values (rest keys) arguments pattern))))

(defn arguments [spec args allow-pattern]
  (let [supplied (read-arguments spec args 0 false {})
        pattern (contains? supplied :every)
        values (merge (get spec :defaults)
                 {:dur (get spec :duration) :id (get spec :id) :offset (get spec :offset)
                  :legato (get spec :legato)} supplied)]
    (when-not (or (= false (get values :legato)) (= true (get values :legato)))
      (throw "instrument: :legato must be true or false"))
    (when (and (get values :legato) (contains? supplied :dur))
      (throw "instrument: :dur does not apply to a held voice; use stop!"))
    (when (and (get values :legato) (get (get spec :held) :error))
      (throw (str "instrument: body cannot use k-rate legato controls: " (get (get spec :held) :error))))
    (when (and pattern (not allow-pattern))
      (throw "with-defaults: :every belongs in an instrument call"))
    (when (and allow-pattern (not pattern) (contains? supplied :offset))
      (throw "instrument: :offset needs :every"))
    (when-not (loop/valid-offset? (get values :offset))
      (throw "instrument: :offset must be finite and between 0 and 1000000000 beats"))
    (when pattern
      (let [durations (get values :every)]
        (when-not (and (vector? durations) (not (empty? durations))
                      (every? loop/valid-duration? durations))
          (throw "instrument: :every needs a nonempty vector of positive beat durations"))))
    (when-not (or (keyword? (get values :id)) (string? (get values :id)))
      (throw "instrument: :id must be a keyword or string"))
    (when-not (valid-value? (get values :dur) pattern true)
      (throw "instrument: :dur needs positive seconds, or a nonempty vector when looping"))
    (validate-values (get spec :params) values pattern)
    (when (and (get spec :held-release)
               (not (fx/in-range? (get values (get spec :held-release)) 0.001 4)))
      (throw "instrument: held release must be 0.001..4 seconds"))
    (when (get spec :validate) ((get spec :validate) values))
    (let [effects (fx/chain (get values :fx))]
      (when (and (not allow-pattern) (contains? supplied :fx))
        (throw "with-defaults: :fx belongs in the instrument call"))
      (when (and (not pattern)
                 (some (fn [effect] (some vector? (get effect :values))) effects))
        (throw "instrument: effect vectors need :every"))
      (assoc values :fx effects))))

(defn ordered-values [keys arguments]
  (if (empty? keys) []
    (cons (get arguments (first keys)) (ordered-values (rest keys) arguments))))

(defn step-form [value]
  (if (vector? value)
    (list 'nth (list 'quote value) (list 'mod 'step (count value)))
    value))

(defn effect-values [effect] (get effect :values))
(defn held-callback [event] nil)

(defn make-callback [compiled duration values route effects]
  ;; Csound submits generated notes directly. Keep the Lisp form as a fallback
  ;; when csound/event is redefined, and retain its identity for dispatch.
  (let [number (get route :number)
        controls (mapv effect-values effects)
        dur (step-form duration)
        fields (vec (map step-form values))
        callback (eval
        (list 'fn ['event]
          (list 'let ['step (list 'get 'event :step)]
            (concat (list 'csound/event "i" (list 'quote compiled) 0 dur)
                    fields (list (list 'get 'event :route))))))]
    (with-meta callback
      {:panaeolus/route route
       :panaeolus/route-plan (when (contains? route :stages) route)
       :panaeolus/tick {:route number :controls controls :instrument compiled
                        :duration duration :values values :callback callback}})))

(defn make-held-callback [compiled values route effects once release]
    (with-meta held-callback
      {:panaeolus/route route
       :panaeolus/route-plan route
       :panaeolus/tick {:route (get route :number) :instrument compiled
                        :legato true :once once :release release :duration 0.1 :values values
                        :controls (mapv effect-values effects)
                        :callback held-callback}}))

;; Preparing a value validates it without starting playback or opening buses.
(defn prepare [instrument args]
  (let [spec (instrument-spec instrument)
        values (arguments spec args true)]
    ;; A timed pattern needs its compiled voice, not copies of both DSP graphs
    ;; in every repeated segment. Held graphs stay frozen until first compiled.
    {:spec (select-keys spec (if (get values :legato)
                              [:id :params :compiled :declaration :held :held-release]
                              [:params :compiled]))
     :values values}))

;; Compile before the clock callback runs. Native code opens the route only
;; when start-prepared! commits the new loop.
(defn prepare-playback [prepared id]
  (let [spec (get prepared :spec)
        values (get prepared :values)
        effects (get values :fx)
        ordered (vec (ordered-values (get spec :params) values))
        legato (get values :legato)
        compiled (if legato
          (routing/held-voice! (get spec :id) (get spec :declaration) @(get (get spec :held) :signal))
          (get spec :compiled))
        plan (assoc (routing/prepare id effects) :voice (when legato compiled))]
    {:durations (if (contains? values :every) (get values :every) [1])
     :offset (get values :offset)
     :callback (if legato
       (make-held-callback compiled ordered plan effects (not (contains? values :every))
         (if (get spec :held-release) (get values (get spec :held-release)) 0))
       (make-callback compiled (get values :dur) ordered plan effects))}))

(defn start-prepared! [id prepared at until]
  (loop/start-at! id (get prepared :durations) (get prepared :callback) at until))

(defn invoke [spec args]
  ;; Validate the whole call before allocating a route or replacing a loop.
  (let [values (arguments spec args true)]
    (if (or (get values :legato) (contains? values :every))
      (let [id (get values :id)
            ready (prepare-playback {:spec spec :values values} id)]
        (if (contains? values :every)
          (loop/start! id (get ready :durations) (get ready :callback) :offset (get values :offset))
          (loop/start! id [1] (get ready :callback))))
      (let [effects (get values :fx)
            ordered (vec (ordered-values (get spec :params) values))
            compiled (get spec :compiled)
            duration (get values :dur)
            route (if (empty? effects) {:number 0} (routing/open! nil effects))
            number (get route :number)]
        (try*
          (do
            (routing/tick! number (mapv routing/initial-controls effects) compiled duration ordered)
            (apply csound/event (concat (list "i" compiled 0 duration) ordered [number]))
            (when (> number 0) (routing/close! route))
            nil)
          (catch* error
            (do (when (> number 0) (routing/close! route))
                (throw error))))))))

(defn invoke-reference [reference & args]
  (invoke (dissoc (resolve-descriptor reference) :signal) args))

(defn make-instrument [spec]
  ;; Callables travel through namespaces, arguments, and plans. Keep one
  ;; descriptor behind a small reference, including in the partial's closure.
  (let [stored (if (or (not (contains? spec :signal)) (atom? (get spec :signal)))
                 spec (assoc spec :signal (atom (get spec :signal))))
        reference (atom stored)]
    (with-meta (partial invoke-reference reference)
      {:panaeolus/instrument {:id (get spec :id) :descriptor reference}})))

;; A catalogue can publish callables without compiling unused graphs. Cache
;; only a successful result; a failed factory remains safe to retry.
(defn defer [id factory]
  (when-not (and (or (string? id) (keyword? id)) (fn? factory))
    (throw "defer: expected an identity and an instrument factory"))
  (make-instrument {:id id :factory factory}))

(defn define-instrument [id params signal held]
  (let [schema (parameter-schema params [] {})
        compiled (routing/voice! id params signal)
        ;; A held graph repeats channel readers for every control. Keep one
        ;; frozen copy instead of copying it through every callable and plan.
        held (if (get held :error) held {:signal (atom (get held :signal))})]
    (make-instrument
      (assoc schema :id id :duration 0.1 :offset 0 :legato false
        :signal signal :compiled compiled :declaration params :held held))))

(defn held-bindings [params index]
  (if (empty? params) []
    (concat [(first params)
             (list 'panaeolus.routing/voice-control
               (list 'last (list 'csound/param-bindings (list 'quote '[route 0]))) index)]
      (held-bindings (drop 2 params) (inc index)))))

(defmacro definst [instrument-name params & body]
  (when-not (and (symbol? instrument-name) (nil? (namespace instrument-name)))
    (throw "definst: name must be an unqualified symbol"))
  (when (empty? body) (throw "definst: an audio body is required"))
  (let [bindings (csound/param-bindings params)]
    (parameter-schema params [] {})
    (list 'def instrument-name
      (list 'panaeolus.instrument/define-instrument
        (list 'str '*ns* "/" (list 'quote instrument-name))
        (list 'quote params)
        (list 'let bindings (cons 'do body))
        ;; Freeze both graphs at definition time. An i-rate-only opcode may
        ;; reject k controls; that leaves the ordinary note voice usable.
        (list 'try*
          (list 'hash-map :signal
            (list 'let (vec (concat (csound/param-bindings []) (held-bindings params 0)))
              (cons 'do body)))
          (list 'catch* 'error (list 'hash-map :error 'error)))))))

(defn with-defaults [instrument & args]
  (let [spec (instrument-spec instrument)
        values (arguments spec args false)]
    (make-instrument
      (assoc spec :defaults (select-keys values (get spec :params))
                  :duration (get values :dur) :id (get values :id)
                  :offset (get values :offset) :legato (get values :legato)))))

(defn with-validator [instrument validate]
  (when-not (fn? validate) (throw "with-validator: expected a function"))
  (make-instrument (assoc (instrument-spec instrument) :validate validate)))

;; Opt in only when the held DSP honors Csound's release flag. Timed voices
;; keep their release inside :dur; the route reserves this tail only on stop.
(defn with-release [instrument parameter]
  (let [spec (instrument-spec instrument)]
    (when-not (and (keyword? parameter) (contains? (get spec :defaults) parameter)
                  (not (get (get spec :held) :error)))
      (throw "with-release: expected a held voice and a release parameter"))
    (let [updated (assoc spec :held-release parameter)]
      (arguments updated [] false)
      (make-instrument updated))))

(defn stop! [instrument-or-id]
  (loop/stop!
    (if (fn? instrument-or-id)
      (if (get (meta instrument-or-id) :panaeolus/plan)
        (get (get (meta instrument-or-id) :panaeolus/plan) :id)
        (let [handle (get (meta instrument-or-id) :panaeolus/instrument)]
          (when-not (atom? (get handle :descriptor))
            (throw "expected a Panaeolus instrument"))
          (get handle :id)))
      instrument-or-id)))

(def record! routing/record!)
(def finish! routing/finish!)
(def export! routing/export!)

(def stop-all! loop/stop-all!)
(def tempo! loop/tempo!)
(ns user)
