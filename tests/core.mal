(ns panaeolus.tests)
(require '[panaeolus.event-loop :as loop])

(def checks (atom 0))
(defn check [label expected actual]
  (if (= expected actual)
    (swap! checks inc)
    (throw (str label ": expected " (pr-str expected) ", got " (pr-str actual)))))
(defn fails? [f] (try* (do (f) false) (catch* error true)))
(defn ignore-event [event] nil)

(check "module loads through require" true (fn? loop/start!))
(check "unknown loop stops cleanly" false (loop/stop! :absent))
(check "empty vector" true (fails? (fn [] (loop/start! :test [] ignore-event))))
(check "list is not vector" true (fails? (fn [] (loop/start! :test '(1 2) ignore-event))))
(check "zero duration" true (fails? (fn [] (loop/start! :test [0] ignore-event))))
(check "negative duration" true (fails? (fn [] (loop/start! :test [-1] ignore-event))))
(check "tiny duration" true (fails? (fn [] (loop/start! :test [0.0000001] ignore-event))))
(check "huge duration" true (fails? (fn [] (loop/start! :test [1000000001] ignore-event))))
(check "nonnumeric duration" true (fails? (fn [] (loop/start! :test ["1"] ignore-event))))
(check "missing callback" true (fails? (fn [] (loop/start! :test [1] nil))))
(check "bad name" true (fails? (fn [] (loop/start! [] [1] ignore-event))))
(check "negative offset" true (fails? (fn [] (loop/start! :test [1] ignore-event :offset -1))))
(check "nonnumeric offset" true (fails? (fn [] (loop/start! :test [1] ignore-event :offset "1"))))
(check "huge offset" true (fails? (fn [] (loop/start! :test [1] ignore-event :offset 1000000001))))
(check "missing offset value" true (fails? (fn [] (loop/start! :test [1] ignore-event :offset))))
(check "unknown loop option" true (fails? (fn [] (loop/start! :test [1] ignore-event :later 1))))
(check "fraction literal reads" true (number? 1/3))
(check "thirds total one beat" 1 (+ (+ 1/3 1/3) 1/3))
(check "fraction zero denominator" true (fails? (fn [] (read-string "1/0"))))
(check "zero tempo" true (fails? (fn [] (loop/tempo! 0))))
(check "negative tempo" true (fails? (fn [] (loop/tempo! -1))))
(check "huge tempo" true (fails? (fn [] (loop/tempo! 10001))))
(check "nonnumeric tempo" true (fails? (fn [] (loop/tempo! "120"))))
(check "set tempo" 120 (loop/tempo! 120))
(check "read beat" true (number? (loop/now)))
(check "start returns name" :test (loop/start! :test [0.25 0.25] ignore-event))
(def original-generation (get @loop/state :serial))
(check "bad replacement fails" true (fails? (fn [] (loop/start! :test [0] ignore-event))))
(check "bad replacement keeps running loop" original-generation (get @loop/state :serial))
(check "replacement returns name" :test (loop/start! :test [0.5] ignore-event))
(check "replacement changes generation" (inc original-generation) (get @loop/state :serial))
(check "replacement keeps one slot" 1 (count (get @loop/state :slots)))
(check "stop active loop" true (loop/stop! :test))
(check "stop again" false (loop/stop! :test))
(check "string name" "other" (loop/start! "other" [1] ignore-event))
(check "stop all" nil (loop/stop-all!))
(check "stop all clears slots" 0 (count (get @loop/state :slots)))
(check "stop all clears names" {} (get @loop/state :names))

(println (str "PASS: " @checks " event-loop core checks"))
(ns user)
